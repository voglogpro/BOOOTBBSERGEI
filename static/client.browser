"use strict";

const tg = window.Telegram?.WebApp;
const state = {
  user: null, circle: null, settings: null, bootstrap: null, trades: [],
  calendarMonth: new Date(new Date().getFullYear(), new Date().getMonth(), 1),
  calendarScope: "me", statsScope: "me", calendarDays: new Map(),
  selectedDay: null, dayTrades: [], calendarRequest: 0, dayRequest: 0,
  statsRequest: 0, dirty: false, currentView: "today", tradeStep: 1,
};

const $ = (selector, root = document) => root.querySelector(selector);
const $$ = (selector, root = document) => [...root.querySelectorAll(selector)];

function todayISO() {
  const now = new Date();
  return `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, "0")}-${String(now.getDate()).padStart(2, "0")}`;
}

function localDateTimeValue(date = new Date()) {
  const offset = date.getTimezoneOffset();
  return new Date(date.getTime() - offset * 60000).toISOString().slice(0, 16);
}

function entryId() {
  return window.crypto?.randomUUID?.() || `${Date.now()}_${Math.random().toString(36).slice(2)}`;
}

function escapeHtml(value) {
  return String(value ?? "").replace(/[&<>'"]/g, (char) => ({
    "&": "&amp;", "<": "&lt;", ">": "&gt;", "'": "&#39;", '"': "&quot;",
  })[char]);
}

function formatMoney(value, signed = false) {
  const amount = Number(value || 0);
  const currency = state.settings?.currency || "USD";
  const formatted = new Intl.NumberFormat("ru-RU", {
    style: "currency", currency, maximumFractionDigits: 2,
  }).format(amount);
  return signed && amount > 0 ? `+${formatted}` : formatted;
}

function formatDate(value, options = { day: "numeric", month: "long" }) {
  if (!value) return "";
  const source = value.length === 10 ? `${value}T12:00:00` : value;
  return new Intl.DateTimeFormat("ru-RU", options).format(new Date(source));
}

function tradesLabel(value) {
  const count = Number(value || 0);
  const mod10 = count % 10;
  const mod100 = count % 100;
  const word = mod10 === 1 && mod100 !== 11
    ? "сделка"
    : mod10 >= 2 && mod10 <= 4 && !(mod100 >= 12 && mod100 <= 14)
      ? "сделки"
      : "сделок";
  return `${count} ${word}`;
}

function displayName(user) {
  return [user?.first_name, user?.last_name].filter(Boolean).join(" ") || user?.username || "Трейдер";
}

function haptic(type = "light") {
  try { if (tg?.isVersionAtLeast?.("6.1")) tg.HapticFeedback?.impactOccurred(type); } catch (_) { /* optional */ }
}

function notifyError() {
  try { if (tg?.isVersionAtLeast?.("6.1")) tg.HapticFeedback?.notificationOccurred("error"); } catch (_) { /* optional */ }
}

function toast(message, timeout = 2600) {
  const element = $("#toast");
  element.textContent = message;
  element.classList.remove("hidden");
  window.clearTimeout(toast.timer);
  toast.timer = window.setTimeout(() => element.classList.add("hidden"), timeout);
}

async function api(path, options = {}) {
  const headers = new Headers(options.headers || {});
  headers.set("X-Telegram-Init-Data", tg?.initData || "");
  if (options.body && !headers.has("Content-Type")) headers.set("Content-Type", "application/json");
  const response = await fetch(path, { ...options, headers });
  const payload = await response.json().catch(() => ({}));
  if (response.status === 401 && !tg?.initData) {
    window.location.replace("/login");
    return await new Promise(() => {});
  }
  if (!response.ok) throw new Error(payload.message || `Ошибка ${response.status}`);
  return payload;
}

async function pending(button, task) {
  if (button?.disabled) return;
  const label = button?.textContent;
  if (button) { button.disabled = true; button.setAttribute("aria-busy", "true"); }
  try { return await task(); }
  finally {
    if (button) { button.disabled = false; button.removeAttribute("aria-busy"); if (label) button.textContent = label; }
  }
}

function setDirty(value) {
  state.dirty = value;
  try {
    if (!tg?.isVersionAtLeast?.("6.2")) return;
    if (value) tg.enableClosingConfirmation(); else tg.disableClosingConfirmation();
  } catch (_) { /* browser preview */ }
}

function setLoading(loading) {
  $("#loading").classList.toggle("hidden", !loading);
  $("#app").classList.toggle("hidden", loading);
}

function showFatal(error) {
  $("#loading").classList.add("hidden");
  $("#app").classList.add("hidden");
  $("#fatal").classList.remove("hidden");
  $("#fatal-message").textContent = error.message || String(error);
}

function applyTelegramTheme() {
  if (!tg?.initData) { document.documentElement.classList.add("web-mode"); return; }
  try {
    tg.ready(); tg.expand();
    if (tg.isVersionAtLeast?.("6.1")) { tg.setHeaderColor("bg_color"); tg.setBackgroundColor("bg_color"); }
  } catch (_) { /* browser preview */ }
}

async function loadBootstrap() {
  const data = await api(`/api/bootstrap?date=${todayISO()}`);
  state.bootstrap = data; state.user = data.user; state.circle = data.circle;
  state.settings = data.settings; state.trades = data.today_trades || [];
  renderHeader(); renderToday(); populateMood(data.today_mood); populateSettings(); renderTeam();
  if (!data.today_mood && !data.circle) $("#mood-form").elements.visibility.value = "private";
}

function renderHeader() {
  const name = displayName(state.user).split(" ")[0];
  const hour = new Date().getHours();
  $("#greeting").textContent = `${hour < 12 ? "Доброе утро" : hour < 18 ? "Добрый день" : "Добрый вечер"}, ${name}`;
  $("#today-label").textContent = formatDate(todayISO(), { weekday: "long", day: "numeric", month: "long" });
  $("#account-caption").textContent = state.settings?.account_name || "Мой счёт";
  $("#challenge-badge").textContent = `Цель ${Number(state.settings?.profit_target_pct || 0)}%`;
  const avatar = $("#user-avatar");
  avatar.textContent = name.slice(0, 1).toUpperCase();
  if (state.user.photo_url) avatar.style.backgroundImage = `url(${JSON.stringify(state.user.photo_url).slice(1, -1)})`;
}

function renderToday() {
  const settings = state.settings || {};
  const stats = state.bootstrap?.stats || {};
  const pnl = state.trades
    .filter((trade) => trade.status === "closed")
    .reduce((sum, trade) => sum + Number(trade.pnl || 0), 0);
  const risk = state.trades.reduce((sum, trade) => sum + Number(trade.risk_amount || 0), 0);
  const planned = state.trades.filter((trade) => Number(trade.plan_followed) === 1).length;
  const planRate = state.trades.length ? Math.round(planned / state.trades.length * 100) : null;
  const dailyLimit = Number(settings.balance || 0) * Number(settings.daily_loss_limit_pct || 0) / 100;
  const lossUsed = Math.max(-pnl, 0);
  const remaining = Math.max(dailyLimit - lossUsed, 0);
  const usedPercent = dailyLimit ? Math.min(lossUsed / dailyLimit * 100, 100) : 0;

  $("#today-pnl").textContent = formatMoney(pnl, true);
  $("#today-pnl").className = `money ${pnl > 0 ? "positive" : pnl < 0 ? "negative" : ""}`;
  $("#streak-value").textContent = stats.streak || 0;
  $("#risk-used").textContent = formatMoney(risk);
  $("#today-trades-count").textContent = state.trades.length;
  $("#plan-rate").textContent = planRate === null ? "—" : `${planRate}%`;
  $("#daily-limit-copy").textContent = dailyLimit ? `${formatMoney(remaining)} из ${formatMoney(dailyLimit)}` : "Настройте счёт";
  $("#daily-limit-bar").style.width = `${usedPercent}%`;
  $("#daily-limit-bar").style.background = usedPercent >= 80 ? "var(--negative)" : usedPercent >= 50 ? "var(--warning)" : "#bce4d9";
  const riskPerTrade = Number(settings.balance || 0) * Number(settings.risk_per_trade_pct || 0) / 100;
  const riskCopy = `${Number(settings.risk_per_trade_pct || 0)}% · ${formatMoney(riskPerTrade)}`;
  $("#plan-risk-limit").textContent = riskCopy;
  $("#summary-risk-limit").textContent = riskCopy;
  $("#plan-trades-limit").textContent = settings.max_trades_day || "—";
  $("#summary-trades-limit").textContent = settings.max_trades_day || "—";
  renderTradeList($("#today-trades"), state.trades, true);
}

function planState(mood) {
  if (Number(mood) <= 1) return "Пауза";
  if (Number(mood) >= 5) return "В форме";
  return "Ровно";
}

function populateMood(mood) {
  const form = $("#mood-form");
  if (!mood) {
    form.classList.remove("hidden");
    $("#plan-summary").classList.add("hidden");
    $("#mood-saved").classList.add("hidden");
    return;
  }
  const simplifiedMood = Number(mood.mood) <= 2 ? 1 : Number(mood.mood) >= 4 ? 5 : 3;
  const radio = $(`input[name="mood"][value="${simplifiedMood}"]`, form);
  if (radio) radio.checked = true;
  for (const key of ["energy", "confidence", "discipline"]) {
    form.elements[key].value = mood[key]; $(`#${key}-output`).value = mood[key];
  }
  for (const key of ["emotion", "note", "focus", "lesson", "day_idea", "key_levels", "day_invalidation", "news_context"]) form.elements[key].value = mood[key] || "";
  form.elements.journal_mode.value = mood.journal_mode || "backtest";
  form.elements.market_bias.value = mood.market_bias || "NEUTRAL";
  form.elements.visibility.value = mood.visibility || "team";
  $("#plan-state-mark").textContent = planState(mood.mood);
  $("#plan-state-mark").dataset.state = simplifiedMood === 1 ? "pause" : simplifiedMood === 5 ? "ready" : "steady";
  $("#plan-mode-mark").textContent = ({ backtest: "Бэктест", demo: "Демо", live: "Реал" })[mood.journal_mode] || "Бэктест";
  $("#plan-bias-mark").textContent = ({ LONG: "Ищу покупки", SHORT: "Ищу продажи", NEUTRAL: "Нейтрально" })[mood.market_bias] || "Нейтрально";
  $("#plan-bias-mark").dataset.bias = mood.market_bias || "NEUTRAL";
  $("#plan-idea-copy").textContent = mood.day_idea || "Идея дня пока не записана";
  $("#plan-focus-copy").textContent = mood.focus || "Работать только по подтверждённому сценарию";
  form.classList.add("hidden");
  $("#plan-summary").classList.remove("hidden");
  $("#mood-saved").classList.remove("hidden");
}

function editPlan() {
  $("#plan-summary").classList.add("hidden");
  $("#mood-form").classList.remove("hidden");
  $("#mood-saved").classList.add("hidden");
  $("#mood-form textarea[name='day_idea']").focus();
}

function populateSettings() {
  const form = $("#settings-form");
  if (!form || !state.settings) return;
  for (const key of ["account_name", "balance", "currency", "profit_target_pct", "daily_loss_limit_pct", "max_loss_limit_pct", "risk_per_trade_pct", "max_trades_day"]) {
    form.elements[key].value = state.settings[key] ?? "";
  }
}

function tradeStatus(trade) {
  return ({ planned: "План", open: "Открыта", cancelled: "Отменена", closed: "Закрыта" })[trade.status] || "Закрыта";
}

function tradeRow(trade, animate = true) {
  const own = Number(trade.user_id) === Number(state.user.id);
  const pnl = Number(trade.pnl || 0);
  const author = own ? "Вы" : escapeHtml(displayName(trade));
  const result = trade.status === "closed" ? formatMoney(pnl, true) : tradeStatus(trade);
  return `<button class="trade-item${animate ? "" : " no-animate"}" data-trade-id="${trade.id}" data-own="${own}" type="button">
    <span class="trade-side ${String(trade.direction).toLowerCase()}">${trade.direction === "BUY" ? "BUY" : "SELL"}</span>
    <span class="trade-main"><strong>${escapeHtml(trade.symbol)}${trade.setup ? ` · ${escapeHtml(trade.setup)}` : ""}</strong><small>${author} · ${formatDate(trade.traded_at, { hour: "2-digit", minute: "2-digit" })}${trade.session ? ` · ${escapeHtml(trade.session)}` : ""}</small></span>
    <span class="trade-result ${pnl > 0 && trade.status === "closed" ? "positive" : pnl < 0 && trade.status === "closed" ? "negative" : ""}">${result}<small>${trade.r_multiple == null ? tradeStatus(trade) : `${Number(trade.r_multiple).toFixed(2)}R`}</small></span>
  </button>`;
}

function renderTradeList(container, trades, editable = false) {
  if (!trades.length) { container.innerHTML = '<div class="empty-state">Записей пока нет. День без сделки тоже часть плана.</div>'; return; }
  container.innerHTML = trades.map((trade) => tradeRow(trade)).join("");
  $$(".trade-item", container).forEach((item) => item.addEventListener("click", () => {
    const trade = trades.find((candidate) => String(candidate.id) === item.dataset.tradeId);
    if (trade) openTradeDialog(trade, !(editable && item.dataset.own === "true"));
  }));
}

async function saveMood(event) {
  event.preventDefault();
  const form = event.currentTarget; const button = $("button[type='submit']", form);
  await pending(button, async () => {
    const data = new FormData(form);
    const payload = {
      mood: Number(data.get("mood")), energy: Number(data.get("energy")), confidence: Number(data.get("confidence")), discipline: Number(data.get("discipline")),
      emotion: data.get("emotion"), note: data.get("note"), focus: data.get("focus"), lesson: data.get("lesson"), visibility: data.get("visibility"),
      journal_mode: data.get("journal_mode"), market_bias: data.get("market_bias"), day_idea: data.get("day_idea"), key_levels: data.get("key_levels"), day_invalidation: data.get("day_invalidation"), news_context: data.get("news_context"),
    };
    await api(`/api/moods/${todayISO()}`, { method: "PUT", body: JSON.stringify(payload) });
    setDirty(false); haptic(); toast("План на день сохранён"); await loadBootstrap();
  });
}

function setTradeReadOnly(readOnly) {
  const form = $("#trade-form");
  form.classList.toggle("trade-form-readonly", readOnly);
  $$("input:not([type='hidden']), select, textarea", form).forEach((field) => { field.disabled = readOnly; });
  $$(".outcome-choice button, .status-choice input", form).forEach((field) => { field.disabled = readOnly; });
  $("#delete-trade").classList.toggle("hidden", readOnly || !form.elements.trade_id.value);
}

function showTradeStep(nextStep) {
  const form = $("#trade-form");
  const step = Math.max(1, Math.min(3, Number(nextStep) || 1));
  state.tradeStep = step;
  $$("[data-step-panel]", form).forEach((panel) => panel.classList.toggle("hidden", Number(panel.dataset.stepPanel) !== step));
  $$("[data-trade-step]").forEach((button) => {
    const active = Number(button.dataset.tradeStep) === step;
    button.classList.toggle("active", active);
    button.classList.toggle("complete", Number(button.dataset.tradeStep) < step);
    if (active) button.setAttribute("aria-current", "step"); else button.removeAttribute("aria-current");
  });
  const readOnly = form.classList.contains("trade-form-readonly");
  $("#trade-back").classList.toggle("hidden", step === 1);
  $("#trade-next").classList.toggle("hidden", step === 3 || readOnly);
  $("#save-trade").classList.toggle("hidden", step !== 3 || readOnly);
  $("#trade-dialog-kicker").textContent = readOnly ? `Просмотр · ${step} из 3` : `Сделка · шаг ${step} из 3`;
  $("#trade-dialog-title").textContent = step === 1 ? "План входа" : step === 2 ? "Исполнение" : "Итог сделки";
  $(".dialog-body", $("#trade-dialog")).scrollTop = 0;
}

function validateTradeStep(step) {
  const panel = $(`[data-step-panel="${step}"]`);
  for (const field of $$("input, select, textarea", panel)) {
    if (!field.disabled && !field.checkValidity()) { field.reportValidity(); return false; }
  }
  return true;
}

function openTradeDialog(trade = null, readOnly = false) {
  const dialog = $("#trade-dialog"); const form = $("#trade-form");
  form.reset(); setTradeReadOnly(false);
  form.elements.traded_at.value = localDateTimeValue(); form.elements.symbol.value = "XAUUSD";
  form.elements.timeframe.value = "M15"; form.elements.status.value = "closed";
  form.elements.journal_mode.value = state.bootstrap?.today_mood?.journal_mode || "backtest";
  form.elements.confidence_before.value = state.bootstrap?.today_mood?.confidence || 3;
  form.elements.plan_followed.value = "true"; form.elements.visibility.value = state.circle ? "team" : "private";
  form.elements.trade_id.value = ""; form.elements.client_entry_id.value = entryId();
  form.elements.outcome_type.value = ""; form.dataset.outcomeChoice = "";
  $("#delete-trade").classList.add("hidden");
  if (trade) {
    const fields = ["symbol", "direction", "status", "timeframe", "session", "setup", "grade", "market_context", "journal_mode", "confidence_before", "trade_plan", "entry_trigger", "trade_invalidation", "outcome_type", "entry_price", "stop_loss", "take_profit", "volume", "risk_amount", "pnl", "r_multiple", "emotion_before", "emotion_after", "mistake", "note", "screenshot_url", "visibility"];
    form.elements.trade_id.value = trade.id; form.elements.client_entry_id.value = trade.client_entry_id || "";
    form.elements.traded_at.value = String(trade.traded_at).slice(0, 16);
    for (const field of fields) form.elements[field].value = trade[field] ?? "";
    form.elements.plan_followed.value = Number(trade.plan_followed) === 1 ? "true" : "false";
    form.dataset.outcomeChoice = trade.outcome_type || (Number(trade.pnl) > 0 ? "take" : Number(trade.pnl) < 0 ? "stop" : trade.status === "closed" ? "breakeven" : "");
    form.elements.outcome_type.value = form.dataset.outcomeChoice;
    $("#delete-trade").classList.remove("hidden");
  }
  const statusRadio = $(`input[name="status_choice"][value="${form.elements.status.value}"]`, form);
  if (statusRadio) statusRadio.checked = true;
  $("#trade-confidence-output").value = form.elements.confidence_before.value || 3;
  setTradeReadOnly(readOnly); updateTradeStage(); updateRPreview();
  showTradeStep(trade ? (trade.status === "closed" || trade.status === "cancelled" ? 3 : 2) : 1);
  setDirty(false); dialog.showModal(); dialog.focus({ preventScroll: true });
}

function tradePayload(form) {
  const data = new FormData(form); const payload = Object.fromEntries(data.entries());
  delete payload.trade_id; delete payload.status_choice;
  for (const key of ["entry_price", "stop_loss", "take_profit", "volume", "risk_amount", "pnl", "r_multiple", "confidence_before"]) payload[key] = payload[key] === "" ? null : Number(payload[key]);
  if (payload.status === "closed" && !payload.outcome_type && payload.pnl != null) payload.outcome_type = payload.pnl > 0 ? "take" : payload.pnl < 0 ? "stop" : "breakeven";
  payload.plan_followed = payload.plan_followed === "true";
  return payload;
}

function updateRPreview() {
  const form = $("#trade-form"); const risk = Number(form.elements.risk_amount.value); const pnl = Number(form.elements.pnl.value);
  $("#r-preview").textContent = risk > 0 && form.elements.pnl.value !== "" ? `Итог: ${(pnl / risk).toFixed(2)}R` : "Укажите риск — результат в R посчитается сам.";
  if (risk > 0 && form.elements.pnl.value !== "" && !form.elements.r_multiple.matches(":focus")) form.elements.r_multiple.value = (pnl / risk).toFixed(2);
  form.elements.pnl.required = form.elements.status.value === "closed";
  const kind = form.dataset.outcomeChoice || (form.elements.pnl.value === "" ? "" : pnl > 0 ? "take" : pnl < 0 ? "stop" : "breakeven");
  $$(".outcome-choice button", form).forEach((button) => button.classList.toggle("active", button.dataset.outcome === kind));
  const badge = $("#outcome-badge");
  badge.textContent = ({ take: "Тейк", stop: "Стоп", breakeven: "Безубыток", manual: "Закрыта вручную", cancelled: "Отменена" })[kind] || "Не выбран";
  badge.dataset.outcome = kind || "none";
}

function updateTradeStage() {
  const form = $("#trade-form");
  const status = form.elements.status.value;
  const closed = status === "closed";
  $("#trade-outcome").classList.toggle("hidden", !closed);
  $("#result-pending").classList.toggle("hidden", closed);
  form.elements.pnl.required = closed;
  $("#save-trade").textContent = closed ? "Сохранить итог" : status === "open" ? "Сохранить открытую сделку" : status === "planned" ? "Сохранить план" : "Сохранить отмену";
  if (status === "cancelled") { form.elements.outcome_type.value = "cancelled"; form.dataset.outcomeChoice = "cancelled"; }
  else if (!closed) { form.elements.outcome_type.value = ""; form.dataset.outcomeChoice = ""; }
  else if (form.dataset.outcomeChoice === "cancelled") { form.elements.outcome_type.value = ""; form.dataset.outcomeChoice = ""; }
  updateRPreview();
}

function chooseOutcome(kind) {
  const form = $("#trade-form");
  const field = form.elements.pnl;
  form.dataset.outcomeChoice = kind; form.elements.outcome_type.value = kind;
  if (kind === "breakeven") field.value = "0";
  else if (field.value !== "" && kind !== "manual") field.value = String(kind === "stop" ? -Math.abs(Number(field.value)) : Math.abs(Number(field.value)));
  field.placeholder = kind === "stop" ? "Например: -250" : kind === "take" ? "Например: 500" : kind === "manual" ? "Фактический итог" : "0";
  updateRPreview(); setDirty(true);
  if (kind !== "breakeven") field.focus();
}

function normalizeOutcomeInput() {
  const form = $("#trade-form");
  const field = form.elements.pnl;
  if (field.value !== "" && form.dataset.outcomeChoice === "stop" && Number(field.value) > 0) field.value = String(-Math.abs(Number(field.value)));
  if (field.value !== "" && form.dataset.outcomeChoice === "take" && Number(field.value) < 0) field.value = String(Math.abs(Number(field.value)));
  updateRPreview();
}

async function saveTrade(event) {
  event.preventDefault();
  const form = event.currentTarget; const button = $("#save-trade"); const id = form.elements.trade_id.value;
  await pending(button, async () => {
    await api(id ? `/api/trades/${id}` : "/api/trades", { method: id ? "PUT" : "POST", body: JSON.stringify(tradePayload(form)) });
    setDirty(false); $("#trade-dialog").close(); haptic("medium"); toast(id ? "Сделка обновлена" : "Сделка записана");
    await loadBootstrap();
    if (state.currentView === "calendar") { await loadCalendar(); if (state.selectedDay) await selectDay(state.selectedDay); }
  });
}

async function askConfirm(message) {
  return new Promise((resolve) => { if (tg?.showConfirm) tg.showConfirm(message, resolve); else resolve(window.confirm(message)); });
}

async function confirmDelete() {
  const id = $("#trade-form").elements.trade_id.value;
  if (!id || !(await askConfirm("Удалить эту сделку из журнала?"))) return;
  await pending($("#delete-trade"), async () => {
    await api(`/api/trades/${id}`, { method: "DELETE" }); setDirty(false); $("#trade-dialog").close(); toast("Сделка удалена"); await loadBootstrap();
    if (state.currentView === "calendar") await loadCalendar();
  });
}

function switchView(name) {
  if (name === state.currentView) return;
  state.currentView = name;
  $$(".view").forEach((view) => view.classList.toggle("active", view.id === `view-${name}`));
  $$(".bottom-nav button").forEach((button) => {
    const active = button.dataset.view === name; button.classList.toggle("active", active);
    if (active) button.setAttribute("aria-current", "page"); else button.removeAttribute("aria-current");
  });
  window.scrollTo({ top: 0, behavior: window.matchMedia("(prefers-reduced-motion: reduce)").matches ? "auto" : "smooth" });
  haptic();
  if (name === "calendar") loadCalendar().catch(showRequestError);
  if (name === "stats") loadStats().catch(showRequestError);
  if (name === "profile") { populateSettings(); renderTeam(); }
}

async function loadCalendar() {
  const requestId = ++state.calendarRequest;
  const month = `${state.calendarMonth.getFullYear()}-${String(state.calendarMonth.getMonth() + 1).padStart(2, "0")}`;
  const data = await api(`/api/calendar?month=${month}&scope=${state.calendarScope}`);
  if (requestId !== state.calendarRequest) return;
  state.calendarDays = new Map(data.days.map((item) => [item.day, item])); renderCalendar();
}

function renderCalendar() {
  const year = state.calendarMonth.getFullYear(); const month = state.calendarMonth.getMonth();
  $("#calendar-title").textContent = new Intl.DateTimeFormat("ru-RU", { month: "long", year: "numeric" }).format(state.calendarMonth);
  const firstWeekday = (new Date(year, month, 1).getDay() + 6) % 7; const daysCount = new Date(year, month + 1, 0).getDate(); const cells = [];
  for (let i = 0; i < firstWeekday; i += 1) cells.push('<div class="calendar-day" aria-hidden="true"></div>');
  for (let day = 1; day <= daysCount; day += 1) {
    const key = `${year}-${String(month + 1).padStart(2, "0")}-${String(day).padStart(2, "0")}`; const info = state.calendarDays.get(key); const pnl = Number(info?.pnl || 0);
    const classes = ["calendar-day", info ? "has-data" : "", key === todayISO() ? "today" : "", key === state.selectedDay ? "selected" : ""].filter(Boolean).join(" ");
    const aria = `${formatDate(key, { day: "numeric", month: "long" })}. ${tradesLabel(info?.trades)}. Результат ${formatMoney(pnl)}`;
    cells.push(`<button class="${classes}" data-day="${key}" type="button" aria-label="${escapeHtml(aria)}"><span>${day}</span><i class="discipline-dot ${Number(info?.discipline || 0) >= 4 ? "good" : ""}"></i>${info?.trades ? `<span class="day-pnl ${pnl > 0 ? "positive" : pnl < 0 ? "negative" : ""}">${pnl > 0 ? "+" : ""}${Math.round(pnl)}</span>` : "<span></span>"}</button>`);
  }
  $("#calendar-grid").innerHTML = cells.join("");
  $$(".calendar-day[data-day]").forEach((button) => button.addEventListener("click", () => selectDay(button.dataset.day).catch(showRequestError)));
}

async function selectDay(day) {
  const requestId = ++state.dayRequest; state.selectedDay = day; renderCalendar();
  const info = state.calendarDays.get(day) || { trades: 0, pnl: 0 };
  const payload = await api(`/api/trades?from=${day}&to=${day}&scope=${state.calendarScope}`);
  if (requestId !== state.dayRequest || state.selectedDay !== day) return;
  state.dayTrades = payload.trades || [];
  const container = $("#day-details");
  container.innerHTML = `<h2>${formatDate(day, { day: "numeric", month: "long", weekday: "long" })}</h2><div class="day-summary"><span>Сделок<strong>${info.trades || 0}</strong></span><span>Итог<strong class="${Number(info.pnl) > 0 ? "positive" : Number(info.pnl) < 0 ? "negative" : ""}">${formatMoney(info.pnl, true)}</strong></span><span>Дисциплина<strong>${info.discipline ? `${info.discipline}/5` : "—"}</strong></span></div><div class="trade-list"></div>`;
  renderTradeList($(".trade-list", container), state.dayTrades, true);
}

async function loadStats() {
  const requestId = ++state.statsRequest; const days = $("#stats-period").value;
  const data = await api(`/api/stats?days=${days}&end=${todayISO()}&scope=${state.statsScope}`);
  if (requestId !== state.statsRequest) return;
  const stats = data.stats;
  $("#stats-pnl").textContent = formatMoney(stats.pnl, true); $("#stats-pnl").className = `money ${Number(stats.pnl) > 0 ? "positive" : Number(stats.pnl) < 0 ? "negative" : ""}`;
  $("#stats-trades").textContent = tradesLabel(stats.trades); $("#stats-winrate").textContent = `${stats.win_rate || 0}%`; $("#stats-wl").textContent = `${stats.wins || 0} / ${stats.losses || 0}`;
  $("#stats-pf").textContent = stats.profit_factor == null ? "—" : Number(stats.profit_factor).toFixed(2); $("#stats-r").textContent = stats.avg_r == null ? "—" : `${Number(stats.avg_r).toFixed(2)}R`;
  $("#stats-expectancy").textContent = formatMoney(stats.expectancy, true); $("#stats-drawdown").textContent = formatMoney(-Math.abs(Number(stats.max_drawdown || 0)));
  $("#stats-plan").textContent = `${stats.plan_rate || 0}% по плану`;
  renderEquity(stats.equity_curve || []); renderObservation(stats); renderBreakdown($("#setup-breakdown"), stats.setups, "pnl"); renderBreakdown($("#session-breakdown"), stats.sessions, "pnl"); renderBreakdown($("#mistake-breakdown"), stats.mistakes, "trades"); renderPatterns($("#confidence-patterns"), stats.confidence_patterns, "Уверенность"); renderPatterns($("#mood-patterns"), stats.mood_patterns, "Настроение");
}

function renderEquity(points) {
  const box = $("#equity-chart");
  if (points.length < 2) { box.innerHTML = '<div class="chart-empty">Нужно минимум два торговых дня.</div>'; return; }
  const values = points.map((item) => Number(item.equity)); const min = Math.min(0, ...values); const max = Math.max(0, ...values); const range = max - min || 1;
  const coords = values.map((value, index) => [index / (values.length - 1) * 100, 92 - (value - min) / range * 78]);
  const line = coords.map(([x, y], index) => `${index ? "L" : "M"}${x.toFixed(2)},${y.toFixed(2)}`).join(" ");
  const area = `${line} L100,100 L0,100 Z`;
  box.innerHTML = `<svg viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true"><path class="area" d="${area}"/><path class="line" d="${line}"/></svg>`;
}

function renderObservation(stats) {
  let title = "Недостаточно записей"; let copy = "После трёх сделок здесь появится конкретное наблюдение.";
  if (Number(stats.trades) >= 3) {
    const confidenceGroups = (stats.confidence_patterns || []).filter((item) => Number(item.trades) >= 3);
    const confidenceSamples = confidenceGroups.reduce((sum, item) => sum + Number(item.trades), 0);
    const bestConfidence = [...confidenceGroups].sort((a, b) => Number(b.win_rate) - Number(a.win_rate))[0];
    const worstConfidence = [...confidenceGroups].sort((a, b) => Number(a.win_rate) - Number(b.win_rate))[0];
    const topMistake = stats.mistakes?.[0]; const topSetup = stats.setups?.filter((item) => Number(item.pnl) > 0).sort((a, b) => Number(b.pnl) - Number(a.pnl))[0];
    if (confidenceSamples >= 10 && confidenceGroups.length >= 2 && Number(bestConfidence.win_rate) - Number(worstConfidence.win_rate) >= 15) { title = `Уверенность ${bestConfidence.label}/5 даёт лучший результат`; copy = `Винрейт ${bestConfidence.win_rate}% против ${worstConfidence.win_rate}% при уверенности ${worstConfidence.label}/5. Это связь в ваших записях, а не доказанная причина.`; }
    else if (Number(stats.plan_rate) < 70) { title = `${stats.plan_rate}% сделок выполнено по плану`; copy = "Это самый прямой участок для улучшения процесса на следующей неделе."; }
    else if (topMistake && Number(topMistake.trades) >= 2) { title = `Повторяется: ${topMistake.label}`; copy = `Ошибка отмечена в ${tradesLabel(topMistake.trades)} за выбранный период.`; }
    else if (topSetup) { title = `Лучший сетап: ${topSetup.label}`; copy = `${tradesLabel(topSetup.trades)}, результат ${formatMoney(topSetup.pnl, true)}, винрейт ${topSetup.win_rate}%.`; }
    else { title = `${stats.plan_rate}% сделок по плану`; copy = `Средняя дисциплина ${stats.avg_discipline || 0}/5, записано дней: ${stats.journal_days || 0}.`; }
  }
  $("#stats-observation").textContent = title; $("#stats-observation-copy").textContent = copy;
}

function renderPatterns(container, rows = [], label = "Оценка") {
  if (!rows?.length) { container.innerHTML = '<div class="breakdown-empty">Появится после сделок с заполненным состоянием.</div>'; return; }
  container.innerHTML = rows.map((row) => {
    const enough = Number(row.trades) >= 3;
    const outcome = Number(row.takes || 0) || Number(row.stops || 0) ? `${row.takes || 0} тейков · ${row.stops || 0} стопов` : `${row.win_rate}% прибыльных`;
    return `<div class="pattern-row"><span class="pattern-score">${escapeHtml(row.label)}</span><div><strong>${label} ${escapeHtml(row.label)}/5</strong><small>${tradesLabel(row.trades)} · ${outcome}</small></div><span class="pattern-result ${Number(row.pnl) > 0 ? "positive" : Number(row.pnl) < 0 ? "negative" : ""}">${enough ? `${row.win_rate}%` : "мало данных"}<small>${row.avg_r == null ? "—" : `${Number(row.avg_r).toFixed(2)}R`}</small></span></div>`;
  }).join("");
}

function renderBreakdown(container, rows = [], mode = "pnl") {
  if (!rows?.length) { container.innerHTML = '<div class="breakdown-empty">Пока нет данных.</div>'; return; }
  container.innerHTML = rows.map((row) => `<div class="breakdown-row"><div><span>${escapeHtml(row.label)}</span><small>${tradesLabel(row.trades)} · ${row.win_rate}% побед</small></div><strong class="${Number(row.pnl) > 0 ? "positive" : Number(row.pnl) < 0 ? "negative" : ""}">${mode === "trades" ? row.trades : formatMoney(row.pnl, true)}</strong></div>`).join("");
}

async function saveSettings(event) {
  event.preventDefault(); const form = event.currentTarget; const button = $("button[type='submit']", form);
  await pending(button, async () => {
    const payload = Object.fromEntries(new FormData(form).entries());
    for (const key of ["balance", "profit_target_pct", "daily_loss_limit_pct", "max_loss_limit_pct", "risk_per_trade_pct", "max_trades_day"]) payload[key] = Number(payload[key]);
    const data = await api("/api/settings", { method: "PUT", body: JSON.stringify(payload) }); state.settings = data.settings; state.bootstrap.settings = data.settings; setDirty(false); renderHeader(); renderToday(); toast("Настройки счёта сохранены"); haptic();
  });
}

function renderTeam() {
  const active = Boolean(state.circle); $("#team-empty").classList.toggle("hidden", active); $("#team-active").classList.toggle("hidden", !active); if (!active) return;
  $("#invite-code").textContent = state.circle.invite_code;
  $("#team-members").innerHTML = (state.circle.members || []).map((member) => { const name = displayName(member); return `<article class="member"><div class="member-avatar">${escapeHtml(name.slice(0, 1).toUpperCase())}</div><div><strong>${escapeHtml(name)}</strong><small>${Number(member.id) === Number(state.user.id) ? "Это вы" : "Напарник"}</small></div></article>`; }).join("");
}

async function createTeam(event) {
  event.preventDefault(); const form = event.currentTarget;
  await pending($("button[type='submit']", form), async () => { const name = new FormData(form).get("name"); const data = await api("/api/circles", { method: "POST", body: JSON.stringify({ name }) }); state.circle = data.circle; renderTeam(); haptic("medium"); toast("Команда создана"); });
}

async function joinTeam(event) {
  event.preventDefault(); const form = event.currentTarget;
  await pending($("button[type='submit']", form), async () => { const invite_code = new FormData(form).get("invite_code"); const data = await api("/api/circles/join", { method: "POST", body: JSON.stringify({ invite_code }) }); state.circle = data.circle; renderTeam(); haptic("medium"); toast("Вы в команде"); });
}

async function leaveTeam() {
  if (!(await askConfirm("Распустить команду? Общий доступ к прежним записям закроется у обоих."))) return;
  await pending($("#leave-team"), async () => { await api("/api/circles/leave", { method: "POST", body: "{}" }); state.circle = null; renderTeam(); toast("Команда распущена"); });
}

async function copyInvite() {
  const code = state.circle?.invite_code; if (!code) return;
  try { await navigator.clipboard.writeText(code); }
  catch (_) { const input = document.createElement("textarea"); input.value = code; input.style.position = "fixed"; input.style.opacity = "0"; document.body.appendChild(input); input.select(); document.execCommand("copy"); input.remove(); }
  haptic(); toast("Код скопирован");
}

async function exportCsv() {
  await pending($("#export-button"), async () => {
    const response = await fetch("/api/export", { headers: { "X-Telegram-Init-Data": tg?.initData || "" } });
    if (!response.ok) throw new Error("Не удалось подготовить экспорт");
    const blob = await response.blob(); const url = URL.createObjectURL(blob); const anchor = document.createElement("a"); anchor.href = url; anchor.download = `trading-journal-${todayISO()}.csv`; document.body.appendChild(anchor); anchor.click(); anchor.remove(); URL.revokeObjectURL(url); toast("CSV подготовлен");
  });
}

async function copyAnalysisPrompt() {
  const prompt = `Проанализируй приложенный CSV моего торгового журнала как датасет бэктестов. Найди не советы по отдельным сделкам, а повторяющиеся закономерности. Сравни confidence_before, day_mood, day_energy, day_confidence и day_emotion с outcome_type, pnl, r_multiple, plan_followed, mistake, setup и session. Отдельно покажи: 1) условия, при которых у меня чаще стопы; 2) условия, при которых чаще тейки; 3) повторяющиеся ошибки и отклонения от плана; 4) сильные сетапы; 5) какие гипотезы проверить следующим бэктестом. Не делай уверенных выводов для группы меньше 5 сделок, указывай размер выборки и отличай корреляцию от причины. В конце дай короткий план из трёх проверяемых изменений.`;
  try { await navigator.clipboard.writeText(prompt); }
  catch (_) { const input = document.createElement("textarea"); input.value = prompt; input.style.position = "fixed"; input.style.opacity = "0"; document.body.appendChild(input); input.select(); document.execCommand("copy"); input.remove(); }
  haptic(); toast("Запрос для анализа скопирован");
}

async function websiteLogout() {
  const response = await fetch("/auth/logout", { method: "POST" });
  if (!response.ok) throw new Error("Не удалось выйти из сайта");
  window.location.replace("/login");
}

function setScope(group, value) {
  $$(`[data-scope-control="${group}"] button`).forEach((button) => { const active = button.dataset.scope === value; button.classList.toggle("active", active); button.setAttribute("aria-pressed", String(active)); });
}

function showRequestError(error) { console.error(error); notifyError(); toast(error.message || "Не удалось выполнить действие", 4200); }

function bindEvents() {
  $("#web-logout").classList.toggle("hidden", Boolean(tg?.initData));
  $$(".bottom-nav button").forEach((button) => button.addEventListener("click", () => switchView(button.dataset.view)));
  $("#profile-shortcut").addEventListener("click", () => switchView("profile"));
  for (const selector of ["#new-trade-primary", "#open-trade-button", "#floating-trade-button"]) $(selector).addEventListener("click", () => openTradeDialog());
  $("#edit-plan").addEventListener("click", editPlan);
  $("#mood-form").addEventListener("submit", (event) => saveMood(event).catch(showRequestError));
  $("#settings-form").addEventListener("submit", (event) => saveSettings(event).catch(showRequestError));
  for (const form of [$("#mood-form"), $("#settings-form"), $("#trade-form")]) form.addEventListener("input", () => setDirty(true));
  for (const key of ["energy", "confidence", "discipline"]) $(`#${key}`).addEventListener("input", (event) => { $(`#${key}-output`).value = event.target.value; });
  $("#close-trade-dialog").addEventListener("click", async () => { if (!state.dirty || await askConfirm("Закрыть без сохранения?") ) { setDirty(false); $("#trade-dialog").close(); } });
  $("#trade-dialog").addEventListener("cancel", (event) => { if (state.dirty) { event.preventDefault(); askConfirm("Закрыть без сохранения?").then((ok) => { if (ok) { setDirty(false); $("#trade-dialog").close(); } }); } });
  $("#trade-form").addEventListener("submit", (event) => saveTrade(event).catch(showRequestError)); $("#delete-trade").addEventListener("click", () => confirmDelete().catch(showRequestError));
  $("#trade-form").elements.risk_amount.addEventListener("input", updateRPreview);
  $("#trade-form").elements.pnl.addEventListener("input", normalizeOutcomeInput);
  $("#trade-confidence").addEventListener("input", (event) => { $("#trade-confidence-output").value = event.target.value; });
  $$("input[name='status_choice']").forEach((radio) => radio.addEventListener("change", () => { $("#trade-form").elements.status.value = radio.value; updateTradeStage(); setDirty(true); }));
  $$(".outcome-choice button").forEach((button) => button.addEventListener("click", () => chooseOutcome(button.dataset.outcome)));
  $$("[data-trade-step]").forEach((button) => button.addEventListener("click", () => { const target = Number(button.dataset.tradeStep); if (target <= state.tradeStep || validateTradeStep(state.tradeStep)) showTradeStep(target); }));
  $("#trade-next").addEventListener("click", () => { if (validateTradeStep(state.tradeStep)) { showTradeStep(state.tradeStep + 1); haptic(); } });
  $("#trade-back").addEventListener("click", () => showTradeStep(state.tradeStep - 1));
  $("#calendar-prev").addEventListener("click", () => { state.calendarMonth.setMonth(state.calendarMonth.getMonth() - 1); state.selectedDay = null; loadCalendar().catch(showRequestError); });
  $("#calendar-next").addEventListener("click", () => { state.calendarMonth.setMonth(state.calendarMonth.getMonth() + 1); state.selectedDay = null; loadCalendar().catch(showRequestError); });
  $$('[data-scope-control="calendar"] button').forEach((button) => button.addEventListener("click", () => { state.calendarScope = button.dataset.scope; setScope("calendar", state.calendarScope); state.selectedDay = null; loadCalendar().catch(showRequestError); }));
  $$('[data-scope-control="stats"] button').forEach((button) => button.addEventListener("click", () => { state.statsScope = button.dataset.scope; setScope("stats", state.statsScope); loadStats().catch(showRequestError); }));
  $("#stats-period").addEventListener("change", () => loadStats().catch(showRequestError));
  $("#create-team-form").addEventListener("submit", (event) => createTeam(event).catch(showRequestError)); $("#join-team-form").addEventListener("submit", (event) => joinTeam(event).catch(showRequestError));
  $("#copy-invite").addEventListener("click", () => copyInvite().catch(showRequestError)); $("#leave-team").addEventListener("click", () => leaveTeam().catch(showRequestError));
  $("#export-button").addEventListener("click", () => exportCsv().catch(showRequestError)); $("#retry-button").addEventListener("click", () => window.location.reload());
  $("#copy-ai-prompt").addEventListener("click", () => copyAnalysisPrompt().catch(showRequestError));
  $("#web-logout").addEventListener("click", () => websiteLogout().catch(showRequestError));
  tg?.onEvent?.("themeChanged", applyTelegramTheme);
}

async function start() { applyTelegramTheme(); bindEvents(); await loadBootstrap(); setLoading(false); }
start().catch(showFatal);
