"use strict";

const tg = window.Telegram?.WebApp;
const state = {
  user: null, circle: null, settings: null, bootstrap: null, trades: [],
  weeklyPlans: [], currentWeeklyPlans: [], weeklyWeek: null, editingWeeklyPlan: null,
  journalDay: null, journalMonth: null, journalPeriodDays: new Map(), journalRequest: 0,
  calendarMonth: new Date(new Date().getFullYear(), new Date().getMonth(), 1),
  calendarScope: "me", statsScope: "me", calendarDays: new Map(),
  selectedDay: null, dayTrades: [], calendarRequest: 0, dayRequest: 0,
  statsRequest: 0, dirty: false, currentView: "today", tradeStep: 1,
  tradeImageFiles: { entry: null, result: null }, currentTradeImages: [], primaryAction: "trade",
};

const $ = (selector, root = document) => root.querySelector(selector);
const $$ = (selector, root = document) => [...root.querySelectorAll(selector)];

function todayISO() {
  const now = new Date();
  return `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, "0")}-${String(now.getDate()).padStart(2, "0")}`;
}

function localDateTimeValue(date = new Date()) {
  const offset = date.getTimezoneOffset();
  return new Date(date.getTime() - offset * 60000).toISOString().slice(0, 16);
}

function weekStartISO(value = todayISO()) {
  const selected = new Date(`${String(value).slice(0, 10)}T12:00:00`);
  const offset = (selected.getDay() + 6) % 7;
  selected.setDate(selected.getDate() - offset);
  return `${selected.getFullYear()}-${String(selected.getMonth() + 1).padStart(2, "0")}-${String(selected.getDate()).padStart(2, "0")}`;
}

function addDaysISO(value, amount) {
  const selected = new Date(`${String(value).slice(0, 10)}T12:00:00`);
  selected.setDate(selected.getDate() + amount);
  return `${selected.getFullYear()}-${String(selected.getMonth() + 1).padStart(2, "0")}-${String(selected.getDate()).padStart(2, "0")}`;
}

function monthISO(value = todayISO()) { return String(value).slice(0, 7); }

function monthGridRange(month) {
  const [year, number] = month.split("-").map(Number);
  const first = `${year}-${String(number).padStart(2, "0")}-01`;
  const lastDate = new Date(year, number, 0);
  const last = `${lastDate.getFullYear()}-${String(lastDate.getMonth() + 1).padStart(2, "0")}-${String(lastDate.getDate()).padStart(2, "0")}`;
  return { start: weekStartISO(first), end: addDaysISO(weekStartISO(last), 6) };
}

function weeksInMonth(month) {
  const range = monthGridRange(month); const weeks = [];
  for (let value = range.start; value <= range.end; value = addDaysISO(value, 7)) weeks.push(value);
  return weeks;
}

function entryId() {
  return window.crypto?.randomUUID?.() || `${Date.now()}_${Math.random().toString(36).slice(2)}`;
}

function escapeHtml(value) {
  return String(value ?? "").replace(/[&<>'"]/g, (char) => ({
    "&": "&amp;", "<": "&lt;", ">": "&gt;", "'": "&#39;", '"': "&quot;",
  })[char]);
}

function formatMoney(value, signed = false) {
  const amount = Number(value || 0);
  const currency = state.settings?.currency || "USD";
  const formatted = new Intl.NumberFormat("ru-RU", {
    style: "currency", currency, maximumFractionDigits: 2,
  }).format(amount);
  return signed && amount > 0 ? `+${formatted}` : formatted;
}

function formatDate(value, options = { day: "numeric", month: "long" }) {
  if (!value) return "";
  const source = value.length === 10 ? `${value}T12:00:00` : value;
  return new Intl.DateTimeFormat("ru-RU", options).format(new Date(source));
}

function tradesLabel(value) {
  const count = Number(value || 0);
  const mod10 = count % 10;
  const mod100 = count % 100;
  const word = mod10 === 1 && mod100 !== 11
    ? "сделка"
    : mod10 >= 2 && mod10 <= 4 && !(mod100 >= 12 && mod100 <= 14)
      ? "сделки"
      : "сделок";
  return `${count} ${word}`;
}

function displayName(user) {
  return [user?.first_name, user?.last_name].filter(Boolean).join(" ") || user?.username || "Трейдер";
}

function haptic(type = "light") {
  try { if (tg?.isVersionAtLeast?.("6.1")) tg.HapticFeedback?.impactOccurred(type); } catch (_) { /* optional */ }
}

function notifyError() {
  try { if (tg?.isVersionAtLeast?.("6.1")) tg.HapticFeedback?.notificationOccurred("error"); } catch (_) { /* optional */ }
}

function toast(message, timeout = 2600) {
  const element = $("#toast");
  element.textContent = message;
  element.classList.remove("hidden");
  window.clearTimeout(toast.timer);
  toast.timer = window.setTimeout(() => element.classList.add("hidden"), timeout);
}

async function api(path, options = {}) {
  const headers = new Headers(options.headers || {});
  headers.set("X-Telegram-Init-Data", tg?.initData || "");
  if (options.body && !(options.body instanceof FormData) && !headers.has("Content-Type")) headers.set("Content-Type", "application/json");
  const response = await fetch(path, { ...options, headers });
  const payload = await response.json().catch(() => ({}));
  if (response.status === 401 && !tg?.initData) {
    window.location.replace("/login");
    return await new Promise(() => {});
  }
  if (!response.ok) throw new Error(payload.message || `Ошибка ${response.status}`);
  return payload;
}

async function pending(button, task) {
  if (button?.disabled) return;
  const label = button?.textContent;
  if (button) { button.disabled = true; button.setAttribute("aria-busy", "true"); }
  try { return await task(); }
  finally {
    if (button) { button.disabled = false; button.removeAttribute("aria-busy"); if (label) button.textContent = label; }
  }
}

function setDirty(value) {
  state.dirty = value;
  try {
    if (!tg?.isVersionAtLeast?.("6.2")) return;
    if (value) tg.enableClosingConfirmation(); else tg.disableClosingConfirmation();
  } catch (_) { /* browser preview */ }
}

function setLoading(loading) {
  $("#loading").classList.toggle("hidden", !loading);
  $("#app").classList.toggle("hidden", loading);
}

function showFatal(error) {
  $("#loading").classList.add("hidden");
  $("#app").classList.add("hidden");
  $("#fatal").classList.remove("hidden");
  $("#fatal-message").textContent = error.message || String(error);
}

function applyTelegramTheme() {
  if (!tg?.initData) { document.documentElement.classList.add("web-mode"); return; }
  try {
    tg.ready(); tg.expand();
    if (tg.isVersionAtLeast?.("6.1")) { tg.setHeaderColor("bg_color"); tg.setBackgroundColor("bg_color"); }
  } catch (_) { /* browser preview */ }
}

async function loadBootstrap() {
  const selectedDay = state.journalDay || todayISO();
  const data = await api(`/api/bootstrap?date=${selectedDay}`);
  state.bootstrap = data; state.user = data.user; state.circle = data.circle;
  state.settings = data.settings; state.trades = data.today_trades || [];
  state.currentWeeklyPlans = data.weekly_plans || [];
  state.journalDay = selectedDay; state.weeklyWeek = weekStartISO(selectedDay);
  state.weeklyPlans = state.currentWeeklyPlans;
  renderHeader(); renderPeriodNavigator(); renderWeeklyPlans(); renderToday(); populateMood(data.today_mood); populateSettings(); renderTeam();
  if (!data.today_mood && !data.circle) $("#mood-form").elements.visibility.value = "private";
}

function renderHeader() {
  const name = displayName(state.user).split(" ")[0];
  const hour = new Date().getHours();
  $("#greeting").textContent = `${hour < 12 ? "Доброе утро" : hour < 18 ? "Добрый день" : "Добрый вечер"}, ${name}`;
  const selectedDay = state.journalDay || todayISO();
  $("#today-label").textContent = `${selectedDay === todayISO() ? "Сегодня · " : ""}${formatDate(selectedDay, { weekday: "long", day: "numeric", month: "long" })}`;
  $("#account-caption").textContent = state.settings?.account_name || "Мой счёт";
  $("#challenge-badge").textContent = `Цель ${Number(state.settings?.profit_target_pct || 0)}%`;
  const avatar = $("#user-avatar");
  avatar.textContent = name.slice(0, 1).toUpperCase();
  if (state.user.photo_url) avatar.style.backgroundImage = `url(${JSON.stringify(state.user.photo_url).slice(1, -1)})`;
}

async function hydrateProtectedImages(root = document) {
  const images = $$('img[data-protected-src]', root);
  await Promise.all(images.map(async (element) => {
    try {
      const response = await fetch(element.dataset.protectedSrc, {
        headers: { "X-Telegram-Init-Data": tg?.initData || "" },
      });
      if (!response.ok) throw new Error("image unavailable");
      const url = URL.createObjectURL(await response.blob());
      element.addEventListener("load", () => URL.revokeObjectURL(url), { once: true });
      element.src = url;
      element.removeAttribute("data-protected-src");
    } catch (_) {
      element.closest("figure")?.classList.add("image-error");
    }
  }));
}

function tradingWeekTitle(weekStart) {
  const end = addDaysISO(weekStart, 4);
  const startCopy = formatDate(weekStart, { day: "numeric", month: "short" }).replace(".", "");
  const endCopy = formatDate(end, { day: "numeric", month: "short" }).replace(".", "");
  return `${startCopy} — ${endCopy}`;
}

function periodWeekStats(weekStart) {
  const result = { pnl: 0, trades: 0, followed: 0, broken: 0 };
  for (let index = 0; index < 7; index += 1) {
    const item = state.journalPeriodDays.get(addDaysISO(weekStart, index));
    result.pnl += Number(item?.pnl || 0); result.trades += Number(item?.trades || 0);
    result.followed += Number(item?.idea_followed || 0); result.broken += Number(item?.idea_broken || 0);
  }
  return result;
}

function renderPeriodNavigator() {
  if (!state.journalMonth) state.journalMonth = monthISO(state.journalDay || todayISO());
  const weekStart = state.weeklyWeek || weekStartISO(state.journalDay || todayISO());
  const selectedDay = state.journalDay || todayISO(); const week = periodWeekStats(weekStart);
  const day = state.journalPeriodDays.get(selectedDay) || { pnl: state.trades.reduce((sum, trade) => sum + (trade.status === "closed" ? Number(trade.pnl || 0) : 0), 0) };
  const marked = week.followed + week.broken; const ideaRate = marked ? Math.round(week.followed / marked * 100) : null;
  $("#journal-month").value = state.journalMonth;
  $("#journal-week-title").textContent = tradingWeekTitle(weekStart);
  $("#weekly-range").textContent = `Неделя ${tradingWeekTitle(weekStart)}`;
  $("#journal-week-pnl").textContent = formatMoney(week.pnl, true);
  $("#journal-week-pnl").className = `money ${week.pnl > 0 ? "positive" : week.pnl < 0 ? "negative" : ""}`;
  $("#journal-day-pnl").textContent = formatMoney(day.pnl, true);
  $("#journal-day-pnl").className = `money ${Number(day.pnl) > 0 ? "positive" : Number(day.pnl) < 0 ? "negative" : ""}`;
  $("#journal-idea-rate").textContent = ideaRate == null ? "Нет отметок" : `${ideaRate}%`;
  $("#journal-week-trades").textContent = week.trades;

  const weeks = weeksInMonth(state.journalMonth);
  $("#journal-week-list").innerHTML = weeks.map((start) => {
    const stats = periodWeekStats(start); const pnl = Number(stats.pnl || 0);
    return `<button class="journal-week-chip ${start === weekStart ? "active" : ""}" data-journal-week="${start}" type="button"><strong>${tradingWeekTitle(start)}</strong><small class="${pnl > 0 ? "positive" : pnl < 0 ? "negative" : ""}">${stats.trades ? formatMoney(pnl, true) : "Нет сделок"}</small></button>`;
  }).join("");

  const labels = ["Пн", "Вт", "Ср", "Чт", "Пт", "Сб", "Вс"];
  $("#journal-day-list").innerHTML = labels.map((label, index) => {
    const value = addDaysISO(weekStart, index); const info = state.journalPeriodDays.get(value); const pnl = Number(info?.pnl || 0);
    return `<button class="journal-day ${value === selectedDay ? "active" : ""} ${value === todayISO() ? "today" : ""}" data-journal-day="${value}" type="button" aria-label="${escapeHtml(formatDate(value, { weekday: "long", day: "numeric", month: "long" }))}"><span>${label}</span><strong>${Number(value.slice(8, 10))}</strong><small class="${pnl > 0 ? "positive" : pnl < 0 ? "negative" : ""}">${info?.trades ? `${pnl > 0 ? "+" : ""}${Math.round(pnl)}` : "—"}</small></button>`;
  }).join("");
  $$("[data-journal-week]").forEach((button) => button.addEventListener("click", () => selectJournalWeek(button.dataset.journalWeek).catch(showRequestError)));
  $$("[data-journal-day]").forEach((button) => button.addEventListener("click", () => selectJournalDay(button.dataset.journalDay).catch(showRequestError)));
}

async function loadJournalPeriod(month = state.journalMonth || monthISO()) {
  const requestId = ++state.journalRequest; const range = monthGridRange(month);
  const data = await api(`/api/calendar?from=${range.start}&to=${range.end}&scope=me`);
  if (requestId !== state.journalRequest) return;
  state.journalMonth = month; state.journalPeriodDays = new Map((data.days || []).map((item) => [item.day, item]));
  renderPeriodNavigator();
}

async function refreshJournalData() {
  await loadBootstrap();
  await loadJournalPeriod(state.journalMonth || monthISO(state.journalDay || todayISO()));
}

async function selectJournalDay(day) {
  if (state.dirty && !(await askConfirm("Перейти к другому дню без сохранения?"))) return;
  setDirty(false); state.journalDay = day; state.weeklyWeek = weekStartISO(day);
  await loadBootstrap(); haptic(); window.scrollTo({ top: 0, behavior: "smooth" });
}

async function selectJournalWeek(week) {
  if (state.dirty && !(await askConfirm("Перейти к другой неделе без сохранения?"))) return;
  setDirty(false);
  const current = state.journalDay || todayISO();
  state.journalDay = current >= week && current <= addDaysISO(week, 6) ? current : week;
  state.weeklyWeek = week; await loadBootstrap(); haptic();
}

async function selectJournalMonth(month) {
  if (!/^\d{4}-\d{2}$/.test(month)) return;
  if (state.dirty && !(await askConfirm("Перейти к другому месяцу без сохранения?"))) return;
  setDirty(false);
  await loadJournalPeriod(month);
  const preferred = month === monthISO(todayISO()) ? todayISO() : `${month}-01`;
  state.journalDay = preferred; state.weeklyWeek = weekStartISO(preferred);
  await loadBootstrap(); haptic();
}

async function shiftJournalMonth(offset) {
  const [year, month] = (state.journalMonth || monthISO()).split("-").map(Number);
  const target = new Date(year, month - 1 + offset, 1);
  await selectJournalMonth(`${target.getFullYear()}-${String(target.getMonth() + 1).padStart(2, "0")}`);
}

function weeklyDays(plan) {
  const values = new Map((plan.days || []).map((item) => [item.day, item]));
  const start = new Date(`${plan.week_start}T12:00:00`);
  const labels = ["Пн", "Вт", "Ср", "Чт", "Пт", "Сб", "Вс"];
  return labels.map((label, index) => {
    const current = new Date(start); current.setDate(start.getDate() + index);
    const day = `${current.getFullYear()}-${String(current.getMonth() + 1).padStart(2, "0")}-${String(current.getDate()).padStart(2, "0")}`;
    const item = values.get(day); const pnl = Number(item?.pnl || 0);
    return `<div class="weekly-day"><span>${label}</span><strong class="${pnl > 0 ? "positive" : pnl < 0 ? "negative" : ""}">${item?.trades ? `${pnl > 0 ? "+" : ""}${Math.round(pnl)}` : "—"}</strong></div>`;
  }).join("");
}

function weeklyPlanCard(plan) {
  const bias = ({ LONG: "Покупки", SHORT: "Продажи", NEUTRAL: "Нейтрально" })[plan.bias] || "Нейтрально";
  const focusRule = plan.bias === "LONG"
    ? "Основной фокус — покупки. Продажа только после подтверждённого разворота."
    : plan.bias === "SHORT"
      ? "Основной фокус — продажи. Покупка только после подтверждённого разворота."
      : "Направление выбирается только после подтверждения сценария.";
  const rate = plan.idea_rate == null ? null : Number(plan.idea_rate);
  const rateClass = rate == null ? "" : rate >= 80 ? "followed" : rate < 50 ? "broken" : "";
  const gallery = plan.images?.length
    ? `<div class="weekly-card-gallery has-images">${plan.images.map((item) => `<img data-protected-src="${escapeHtml(item.url)}" alt="График ${escapeHtml(plan.symbol)}">`).join("")}</div>`
    : "";
  const review = plan.status === "reviewed" && plan.week_summary ? `<div class="weekly-review-copy"><span>Итог недели${plan.rating ? ` · ${plan.rating}/5` : ""}</span><p>${escapeHtml(plan.week_summary)}</p></div>` : "";
  return `<button class="weekly-plan-card" data-weekly-plan-id="${plan.id}" type="button">${gallery}<div class="weekly-card-content"><div class="weekly-card-top"><strong class="weekly-symbol">${escapeHtml(plan.symbol)} <span class="bias-badge" data-bias="${escapeHtml(plan.bias)}">${bias}</span></strong><span class="idea-badge ${rateClass}">${rate == null ? "Нет отметок" : `${rate}% по идее`}</span></div><h3>${escapeHtml(plan.title || "Торговая идея")}${plan.status === "reviewed" ? ' <span class="reviewed-badge">Итог готов</span>' : ""}</h3><p class="weekly-card-idea">${escapeHtml(plan.idea)}</p><div class="weekly-focus-rule"><span>${plan.bias === "LONG" ? "↑" : plan.bias === "SHORT" ? "↓" : "→"}</span><p><b>Правило фокуса</b>${focusRule}</p></div><div class="weekly-card-metrics"><span>Итог недели<strong class="${Number(plan.pnl) > 0 ? "positive" : Number(plan.pnl) < 0 ? "negative" : ""}">${formatMoney(plan.pnl, true)}</strong></span><span>Сделок<strong>${plan.trades || 0}</strong></span><span>По идее<strong>${plan.idea_followed || 0} / ${(plan.idea_followed || 0) + (plan.idea_broken || 0)}</strong></span></div><div class="weekly-days">${weeklyDays(plan)}</div>${review}</div></button>`;
}

function renderWeeklyPlans() {
  const container = $("#weekly-plan-list");
  if (!state.weeklyPlans.length) {
    container.innerHTML = '<button class="weekly-empty" type="button"><i>↗</i><span><strong>Добавьте первую идею недели</strong><small>График, сценарий и результат будут собраны в одном месте.</small></span></button>';
    $(".weekly-empty", container).addEventListener("click", () => openWeeklyPlanDialog());
    return;
  }
  container.innerHTML = state.weeklyPlans.map(weeklyPlanCard).join("");
  $$(".weekly-plan-card", container).forEach((card) => card.addEventListener("click", () => {
    const plan = state.weeklyPlans.find((item) => String(item.id) === card.dataset.weeklyPlanId);
    if (plan) openWeeklyPlanDialog(plan);
  }));
  hydrateProtectedImages(container);
}

function renderToday() {
  const settings = state.settings || {};
  const stats = state.bootstrap?.stats || {};
  const pnl = state.trades
    .filter((trade) => trade.status === "closed")
    .reduce((sum, trade) => sum + Number(trade.pnl || 0), 0);
  const risk = state.trades.reduce((sum, trade) => sum + Number(trade.risk_amount || 0), 0);
  const planned = state.trades.filter((trade) => Number(trade.plan_followed) === 1).length;
  const planRate = state.trades.length ? Math.round(planned / state.trades.length * 100) : null;
  const dailyLimit = Number(settings.balance || 0) * Number(settings.daily_loss_limit_pct || 0) / 100;
  const lossUsed = Math.max(-pnl, 0);
  const remaining = Math.max(dailyLimit - lossUsed, 0);
  const usedPercent = dailyLimit ? Math.min(lossUsed / dailyLimit * 100, 100) : 0;

  $("#today-pnl").textContent = formatMoney(pnl, true);
  $("#today-pnl").className = `money ${pnl > 0 ? "positive" : pnl < 0 ? "negative" : ""}`;
  $("#streak-value").textContent = stats.streak || 0;
  $("#risk-used").textContent = formatMoney(risk);
  $("#today-trades-count").textContent = state.trades.length;
  $("#plan-rate").textContent = planRate === null ? "—" : `${planRate}%`;
  $("#daily-limit-copy").textContent = dailyLimit ? `${formatMoney(remaining)} из ${formatMoney(dailyLimit)}` : "Настройте счёт";
  $("#daily-limit-bar").style.width = `${usedPercent}%`;
  $("#daily-limit-bar").style.background = usedPercent >= 80 ? "var(--negative)" : usedPercent >= 50 ? "var(--warning)" : "#bce4d9";
  const riskPerTrade = Number(settings.balance || 0) * Number(settings.risk_per_trade_pct || 0) / 100;
  const riskCopy = `${Number(settings.risk_per_trade_pct || 0)}% · ${formatMoney(riskPerTrade)}`;
  $("#plan-risk-limit").textContent = riskCopy;
  $("#summary-risk-limit").textContent = riskCopy;
  $("#plan-trades-limit").textContent = settings.max_trades_day || "—";
  $("#summary-trades-limit").textContent = settings.max_trades_day || "—";
  $("#day-trades-title").textContent = `Сделки · ${formatDate(state.journalDay || todayISO(), { day: "numeric", month: "long" })}`;
  renderTradeList($("#today-trades"), state.trades, true);
  renderPeriodNavigator();
  updatePrimaryAction();
}

function updatePrimaryAction() {
  const button = $("#new-trade-primary");
  const copy = $("span", button);
  const openTrade = state.trades.find((trade) => trade.status === "open");
  const plannedTrade = state.trades.find((trade) => trade.status === "planned");
  if (!state.currentWeeklyPlans.length) {
    state.primaryAction = "week"; copy.textContent = "Составить план недели";
  } else if (!state.bootstrap?.today_mood) {
    state.primaryAction = "day"; copy.textContent = "Составить план на сегодня";
  } else if (openTrade) {
    state.primaryAction = `result:${openTrade.id}`; copy.textContent = "Записать итог сделки";
  } else if (plannedTrade) {
    state.primaryAction = `permit:${plannedTrade.id}`; copy.textContent = "Проверить вход по плану";
  } else {
    state.primaryAction = "trade"; copy.textContent = "Подготовить сделку";
  }
}

function runPrimaryAction() {
  if (state.primaryAction === "week") return openWeeklyPlanDialog();
  if (state.primaryAction === "day") {
    editPlan();
    $(".checkin-panel").scrollIntoView({ behavior: "smooth", block: "start" });
    return;
  }
  const [, id] = String(state.primaryAction).split(":");
  const trade = id ? state.trades.find((item) => String(item.id) === id) : null;
  openTradeDialog(trade || null);
}

function planState(mood) {
  if (Number(mood) <= 1) return "Пауза";
  if (Number(mood) >= 5) return "В форме";
  return "Ровно";
}

function populateMood(mood) {
  const form = $("#mood-form");
  if (!mood) {
    form.reset();
    for (const key of ["energy", "confidence", "discipline"]) $(`#${key}-output`).value = form.elements[key].value;
    form.classList.remove("hidden");
    $("#plan-summary").classList.add("hidden");
    $("#mood-saved").classList.add("hidden");
    updatePrimaryAction();
    return;
  }
  const simplifiedMood = Number(mood.mood) <= 2 ? 1 : Number(mood.mood) >= 4 ? 5 : 3;
  const radio = $(`input[name="mood"][value="${simplifiedMood}"]`, form);
  if (radio) radio.checked = true;
  for (const key of ["energy", "confidence", "discipline"]) {
    form.elements[key].value = mood[key]; $(`#${key}-output`).value = mood[key];
  }
  for (const key of ["emotion", "note", "focus", "lesson", "day_idea", "key_levels", "day_invalidation", "news_context"]) form.elements[key].value = mood[key] || "";
  form.elements.journal_mode.value = mood.journal_mode || "backtest";
  form.elements.market_bias.value = mood.market_bias || "NEUTRAL";
  form.elements.visibility.value = mood.visibility || "team";
  $("#plan-state-mark").textContent = planState(mood.mood);
  $("#plan-state-mark").dataset.state = simplifiedMood === 1 ? "pause" : simplifiedMood === 5 ? "ready" : "steady";
  $("#plan-mode-mark").textContent = ({ backtest: "Бэктест", demo: "Демо", live: "Реал" })[mood.journal_mode] || "Бэктест";
  $("#plan-bias-mark").textContent = ({ LONG: "Ищу покупки", SHORT: "Ищу продажи", NEUTRAL: "Нейтрально" })[mood.market_bias] || "Нейтрально";
  $("#plan-bias-mark").dataset.bias = mood.market_bias || "NEUTRAL";
  $("#plan-idea-copy").textContent = mood.day_idea || "Идея дня пока не записана";
  $("#plan-focus-copy").textContent = mood.focus || "Работать только по подтверждённому сценарию";
  form.classList.add("hidden");
  $("#plan-summary").classList.remove("hidden");
  $("#mood-saved").classList.remove("hidden");
  updatePrimaryAction();
}

function editPlan() {
  $("#plan-summary").classList.add("hidden");
  $("#mood-form").classList.remove("hidden");
  $("#mood-saved").classList.add("hidden");
  $("#mood-form textarea[name='day_idea']").focus();
}

function populateSettings() {
  const form = $("#settings-form");
  if (!form || !state.settings) return;
  for (const key of ["account_name", "balance", "currency", "profit_target_pct", "daily_loss_limit_pct", "max_loss_limit_pct", "risk_per_trade_pct", "max_trades_day"]) {
    form.elements[key].value = state.settings[key] ?? "";
  }
}

function tradeStatus(trade) {
  return ({ planned: "План", open: "Открыта", cancelled: "Отменена", closed: "Закрыта" })[trade.status] || "Закрыта";
}

function tradeRow(trade, animate = true) {
  const own = Number(trade.user_id) === Number(state.user.id);
  const pnl = Number(trade.pnl || 0);
  const author = own ? "Вы" : escapeHtml(displayName(trade));
  const result = trade.status === "closed" ? formatMoney(pnl, true) : tradeStatus(trade);
  const ideaMark = trade.weekly_plan_id && trade.idea_followed != null
    ? `<span class="trade-idea-mark ${Number(trade.idea_followed) === 1 ? "" : "broken"}">${Number(trade.idea_followed) === 1 ? "По идее недели" : "Вне идеи недели"}</span>`
    : "";
  const countertrendMark = Number(trade.countertrend_confirmed) === 1 ? '<span class="trade-idea-mark countertrend">Разворот подтверждён</span>' : "";
  const breachMark = Number(trade.entered_without_plan) === 1 ? '<span class="trade-idea-mark breach">Вход без допуска</span>' : "";
  const image = trade.images?.find((item) => item.kind === "entry") || trade.images?.find((item) => item.kind === "result");
  const thumb = image ? `<span class="trade-thumb"><img data-protected-src="${escapeHtml(image.url)}" alt="Скриншот ${escapeHtml(trade.symbol)}"></span>` : "";
  return `<button class="trade-item${image ? " has-image" : ""}${animate ? "" : " no-animate"}" data-trade-id="${trade.id}" data-own="${own}" type="button">
    ${thumb}
    <span class="trade-side ${String(trade.direction).toLowerCase()}">${trade.direction === "BUY" ? "BUY" : "SELL"}</span>
    <span class="trade-main"><strong>${escapeHtml(trade.symbol)}${trade.setup ? ` · ${escapeHtml(trade.setup)}` : ""}</strong><small>${author} · ${formatDate(trade.traded_at, { hour: "2-digit", minute: "2-digit" })}${trade.session ? ` · ${escapeHtml(trade.session)}` : ""}</small>${ideaMark}${countertrendMark}${breachMark}</span>
    <span class="trade-result ${pnl > 0 && trade.status === "closed" ? "positive" : pnl < 0 && trade.status === "closed" ? "negative" : ""}">${result}<small>${trade.r_multiple == null ? tradeStatus(trade) : `${Number(trade.r_multiple).toFixed(2)}R`}</small></span>
  </button>`;
}

function renderTradeList(container, trades, editable = false) {
  if (!trades.length) { container.innerHTML = '<div class="empty-state">Записей пока нет. День без сделки тоже часть плана.</div>'; return; }
  container.innerHTML = trades.map((trade) => tradeRow(trade)).join("");
  $$(".trade-item", container).forEach((item) => item.addEventListener("click", () => {
    const trade = trades.find((candidate) => String(candidate.id) === item.dataset.tradeId);
    if (trade) openTradeDialog(trade, !(editable && item.dataset.own === "true"));
  }));
  hydrateProtectedImages(container);
}

async function saveMood(event) {
  event.preventDefault();
  const form = event.currentTarget; const button = $("button[type='submit']", form);
  await pending(button, async () => {
    const data = new FormData(form);
    const payload = {
      mood: Number(data.get("mood")), energy: Number(data.get("energy")), confidence: Number(data.get("confidence")), discipline: Number(data.get("discipline")),
      emotion: data.get("emotion"), note: data.get("note"), focus: data.get("focus"), lesson: data.get("lesson"), visibility: data.get("visibility"),
      journal_mode: data.get("journal_mode"), market_bias: data.get("market_bias"), day_idea: data.get("day_idea"), key_levels: data.get("key_levels"), day_invalidation: data.get("day_invalidation"), news_context: data.get("news_context"),
    };
    await api(`/api/moods/${state.journalDay || todayISO()}`, { method: "PUT", body: JSON.stringify(payload) });
    setDirty(false); haptic(); toast("План на день сохранён"); await refreshJournalData();
  });
}

function renderWeeklyImagePreview() {
  const container = $("#weekly-image-preview");
  const existing = state.editingWeeklyPlan?.images || [];
  const selected = [...$("#weekly-plan-images").files];
  const oldImages = existing.map((item) => `<figure><img data-protected-src="${escapeHtml(item.url)}" data-view-plan-image="${escapeHtml(item.url)}" alt="График недельного плана"><button data-delete-plan-image="${item.id}" type="button" aria-label="Удалить фотографию">×</button></figure>`);
  const newImages = selected.map((file) => {
    const url = URL.createObjectURL(file);
    return `<figure class="new-image"><img src="${url}" data-view-plan-image="${url}" alt="Новая фотография"><span class="saved-mark">Будет добавлено</span></figure>`;
  });
  container.innerHTML = [...oldImages, ...newImages].join("");
  $$('[data-delete-plan-image]', container).forEach((button) => button.addEventListener("click", () => deleteWeeklyPlanImage(Number(button.dataset.deletePlanImage)).catch(showRequestError)));
  $$('[data-view-plan-image]', container).forEach((image) => image.addEventListener("click", () => openPlanImage(image.dataset.viewPlanImage).catch(showRequestError)));
  hydrateProtectedImages(container);
}

async function openPlanImage(source) {
  const dialog = $("#plan-image-viewer"); const image = $("img", dialog);
  if (source.startsWith("/api/")) {
    const response = await fetch(source, { headers: { "X-Telegram-Init-Data": tg?.initData || "" } });
    if (!response.ok) throw new Error("Не удалось открыть фотографию");
    const url = URL.createObjectURL(await response.blob()); dialog.dataset.objectUrl = url; image.src = url;
  } else image.src = source;
  dialog.showModal();
}

function closePlanImage() {
  const dialog = $("#plan-image-viewer"); dialog.close(); $("img", dialog).removeAttribute("src");
  if (dialog.dataset.objectUrl) { URL.revokeObjectURL(dialog.dataset.objectUrl); delete dialog.dataset.objectUrl; }
}

function openWeeklyPlanDialog(plan = null) {
  const dialog = $("#weekly-plan-dialog"); const form = $("#weekly-plan-form");
  form.reset(); state.editingWeeklyPlan = plan; form.elements.plan_id.value = plan?.id || "";
  form.elements.week_start.value = plan?.week_start || state.weeklyWeek || weekStartISO();
  form.elements.visibility.value = plan?.visibility || (state.circle ? "team" : "private");
  const fields = ["symbol", "bias", "title", "idea", "trade_plan", "invalidation", "status", "week_summary", "week_lesson", "rating"];
  if (plan) for (const field of fields) form.elements[field].value = plan[field] ?? "";
  else { form.elements.symbol.value = "XAUUSD"; form.elements.bias.value = "NEUTRAL"; form.elements.status.value = "active"; }
  $("#weekly-plan-dialog-title").textContent = plan ? `${plan.symbol} · план недели` : "Новая торговая идея";
  $("#delete-weekly-plan").classList.toggle("hidden", !plan);
  $("#weekly-review").open = Boolean(plan?.status === "reviewed" || plan?.week_summary || plan?.week_lesson);
  renderWeeklyImagePreview(); setDirty(false); dialog.showModal(); dialog.focus({ preventScroll: true });
}

function weeklyPlanPayload(form) {
  const data = new FormData(form);
  return {
    week_start: data.get("week_start"), symbol: data.get("symbol"), bias: data.get("bias"),
    title: data.get("title"), idea: data.get("idea"), trade_plan: data.get("trade_plan"),
    invalidation: data.get("invalidation"), status: data.get("status"),
    week_summary: data.get("week_summary"), week_lesson: data.get("week_lesson"),
    rating: data.get("rating") === "" ? null : Number(data.get("rating")), visibility: data.get("visibility"),
  };
}

async function compressPlanImage(file) {
  if (!["image/jpeg", "image/png", "image/webp"].includes(file.type)) throw new Error("Поддерживаются JPG, PNG и WebP");
  const url = URL.createObjectURL(file);
  const image = new Image();
  await new Promise((resolve, reject) => { image.onload = resolve; image.onerror = () => reject(new Error("Не удалось прочитать фотографию")); image.src = url; });
  URL.revokeObjectURL(url);
  const maxSide = 1800; const scale = Math.min(1, maxSide / Math.max(image.naturalWidth, image.naturalHeight));
  if (scale === 1 && file.size <= 5.5 * 1024 * 1024) return { blob: file, name: file.name };
  const canvas = document.createElement("canvas"); canvas.width = Math.max(1, Math.round(image.naturalWidth * scale)); canvas.height = Math.max(1, Math.round(image.naturalHeight * scale));
  canvas.getContext("2d").drawImage(image, 0, 0, canvas.width, canvas.height);
  const mime = file.type === "image/png" ? "image/png" : "image/jpeg";
  const blob = await new Promise((resolve) => canvas.toBlob(resolve, mime, .88));
  if (!blob) throw new Error("Не удалось подготовить фотографию");
  return { blob, name: file.name.replace(/\.[^.]+$/, mime === "image/png" ? ".png" : ".jpg") };
}

async function saveWeeklyPlan(event) {
  event.preventDefault(); const form = event.currentTarget; const button = $("#save-weekly-plan");
  const files = [...form.elements.images.files]; const existingCount = state.editingWeeklyPlan?.images?.length || 0;
  if (existingCount + files.length > 4) throw new Error("В одном плане может быть не больше четырёх фотографий");
  await pending(button, async () => {
    const id = form.elements.plan_id.value;
    const result = await api(id ? `/api/weekly-plans/${id}` : "/api/weekly-plans", { method: id ? "PUT" : "POST", body: JSON.stringify(weeklyPlanPayload(form)) });
    form.elements.plan_id.value = result.plan.id;
    state.editingWeeklyPlan = { ...(state.editingWeeklyPlan || {}), ...result.plan, images: state.editingWeeklyPlan?.images || [] };
    for (let index = 0; index < files.length; index += 1) {
      button.textContent = `Загружаем фото ${index + 1} из ${files.length}`;
      const prepared = await compressPlanImage(files[index]); const body = new FormData();
      body.append("image", prepared.blob, prepared.name);
      const uploaded = await api(`/api/weekly-plans/${result.plan.id}/images`, { method: "POST", body });
      state.editingWeeklyPlan.images.push(uploaded.image);
    }
    setDirty(false); $("#weekly-plan-dialog").close();
    if (!(state.journalDay >= result.plan.week_start && state.journalDay <= addDaysISO(result.plan.week_start, 6))) state.journalDay = result.plan.week_start;
    if (!weeksInMonth(state.journalMonth).includes(result.plan.week_start)) state.journalMonth = monthISO(result.plan.week_start);
    await refreshJournalData(); haptic("medium"); toast(id ? "План недели обновлён" : "Идея недели сохранена");
  });
}

async function deleteWeeklyPlanImage(imageId) {
  if (!(await askConfirm("Удалить эту фотографию из недельного плана?"))) return;
  await api(`/api/weekly-plan-images/${imageId}`, { method: "DELETE" });
  if (state.editingWeeklyPlan) state.editingWeeklyPlan.images = state.editingWeeklyPlan.images.filter((item) => Number(item.id) !== Number(imageId));
  renderWeeklyImagePreview(); setDirty(true); toast("Фотография удалена");
}

async function deleteWeeklyPlan() {
  const id = $("#weekly-plan-form").elements.plan_id.value;
  if (!id || !(await askConfirm("Удалить недельный план? Сделки останутся, но связь с идеей будет снята."))) return;
  await pending($("#delete-weekly-plan"), async () => {
    await api(`/api/weekly-plans/${id}`, { method: "DELETE" }); setDirty(false); $("#weekly-plan-dialog").close(); await refreshJournalData(); toast("Недельный план удалён");
  });
}

function setTradeReadOnly(readOnly) {
  const form = $("#trade-form");
  form.classList.toggle("trade-form-readonly", readOnly);
  $$("input:not([type='hidden']), select, textarea", form).forEach((field) => { field.disabled = readOnly; });
  $$(".outcome-choice button, .status-choice input", form).forEach((field) => { field.disabled = readOnly; });
  $("#delete-trade").classList.toggle("hidden", readOnly || !form.elements.trade_id.value);
}

function showTradeStep(nextStep) {
  const form = $("#trade-form");
  const step = Math.max(1, Math.min(3, Number(nextStep) || 1));
  state.tradeStep = step;
  $$("[data-step-panel]", form).forEach((panel) => panel.classList.toggle("hidden", Number(panel.dataset.stepPanel) !== step));
  $$("[data-trade-step]").forEach((button) => {
    const active = Number(button.dataset.tradeStep) === step;
    button.classList.toggle("active", active);
    button.classList.toggle("complete", Number(button.dataset.tradeStep) < step);
    if (active) button.setAttribute("aria-current", "step"); else button.removeAttribute("aria-current");
  });
  const readOnly = form.classList.contains("trade-form-readonly");
  $("#trade-back").classList.toggle("hidden", step === 1);
  $("#trade-next").classList.toggle("hidden", step === 3 || readOnly);
  const quickSave = step === 3 || step === 2 || (step === 1 && form.elements.status.value === "planned");
  $("#save-trade").classList.toggle("hidden", !quickSave || readOnly);
  $("#trade-next").textContent = step === 1 ? "К исполнению" : "К итогу";
  $("#trade-next").classList.toggle("secondary", quickSave);
  $("#trade-next").classList.toggle("primary", !quickSave);
  $("#trade-dialog-kicker").textContent = readOnly ? `Просмотр · ${step} из 3` : `Сделка · шаг ${step} из 3`;
  $("#trade-dialog-title").textContent = step === 1 ? "План входа" : step === 2 ? "Исполнение" : "Итог сделки";
  $(".dialog-body", $("#trade-dialog")).scrollTop = 0;
}

function validateTradeStep(step) {
  const panel = $(`[data-step-panel="${step}"]`);
  for (const field of $$("input, select, textarea", panel)) {
    if (!field.disabled && !field.checkValidity()) { field.reportValidity(); return false; }
  }
  const form = $("#trade-form");
  const liveExecution = form.elements.journal_mode.value === "live" && ["open", "closed"].includes(form.elements.status.value);
  const breach = form.elements.entered_without_plan.checked;
  if (step === 2 && liveExecution && !breach) {
    if (!form.elements.trade_id.value) {
      showRequestError(new Error("Сначала сохраните эту запись как «Только план», затем откройте её после появления триггера"));
      return false;
    }
    if (!form.elements.weekly_plan_id.value) {
      showRequestError(new Error("Для реальной сделки выберите идею недели"));
      showTradeStep(1); window.setTimeout(() => form.elements.weekly_plan_id.focus(), 0); return false;
    }
    for (const [name, message] of [
      ["trade_plan", "Запишите план сделки до входа"],
      ["entry_trigger", "Запишите проверяемый триггер входа"],
      ["trade_invalidation", "Запишите условие отмены сделки"],
    ]) {
      if (!form.elements[name].value.trim()) {
        showRequestError(new Error(message)); showTradeStep(1); window.setTimeout(() => form.elements[name].focus(), 0); return false;
      }
    }
    if (!form.elements.trigger_confirmed.checked) {
      showRequestError(new Error("Не входите раньше: сначала дождитесь фактического триггера"));
      window.setTimeout(() => form.elements.trigger_confirmed.focus(), 0); return false;
    }
    if (form.elements.trigger_evidence.value.trim().length < 12) {
      showRequestError(new Error("Опишите, какой фактический сигнал появился на графике"));
      window.setTimeout(() => form.elements.trigger_evidence.focus(), 0); return false;
    }
    if (!(Number(form.elements.risk_amount.value) > 0) || form.elements.stop_loss.value === "") {
      showRequestError(new Error("До входа укажите риск и стоп"));
      window.setTimeout(() => form.elements.risk_amount.focus(), 0); return false;
    }
  }
  if (
    step === 2 && $("#trend-guard").dataset.state === "counter"
    && ["open", "closed"].includes(form.elements.status.value)
    && !breach
    && !form.elements.countertrend_confirmed.checked
  ) {
    showRequestError(new Error("Перед контртрендовой сделкой подтвердите разворот"));
    showTradeStep(1); window.setTimeout(() => form.elements.countertrend_confirmed.focus(), 0); return false;
  }
  if (
    step === 2 && liveExecution && !breach
    && $("#trend-guard").dataset.state === "counter"
    && form.elements.countertrend_evidence.value.trim().length < 12
  ) {
    showRequestError(new Error("Опишите, чем именно подтверждён разворот"));
    showTradeStep(1); window.setTimeout(() => form.elements.countertrend_evidence.focus(), 0); return false;
  }
  return true;
}

function populateWeeklyPlanOptions(selected = "", linkedTrade = null) {
  const select = $("#trade-form").elements.weekly_plan_id;
  const options = ['<option value="">Без недельного плана</option>'];
  for (const plan of state.currentWeeklyPlans) options.push(`<option value="${plan.id}" data-bias="${escapeHtml(plan.bias)}">${escapeHtml(plan.symbol)} · ${escapeHtml(plan.title || "Идея недели")}</option>`);
  if (selected && !state.currentWeeklyPlans.some((plan) => String(plan.id) === String(selected))) {
    options.push(`<option value="${escapeHtml(selected)}" data-bias="${escapeHtml(linkedTrade?.weekly_plan_bias || "")}">${escapeHtml(linkedTrade?.weekly_plan_symbol || linkedTrade?.symbol || "План")} · ${escapeHtml(linkedTrade?.weekly_plan_title || "Идея прошлой недели")}</option>`);
  }
  select.innerHTML = options.join(""); select.value = selected || "";
}

function updateTrendGuard() {
  const form = $("#trade-form"); const guard = $("#trend-guard");
  const option = form.elements.weekly_plan_id.selectedOptions[0]; const bias = option?.dataset.bias || "";
  const dayBias = form.dataset.dayBias || "NEUTRAL";
  const direction = form.elements.direction.value; const expected = bias === "LONG" ? "BUY" : bias === "SHORT" ? "SELL" : "";
  const dayExpected = dayBias === "LONG" ? "BUY" : dayBias === "SHORT" ? "SELL" : "";
  const expectations = [expected, dayExpected].filter(Boolean);
  const planConflict = Boolean(expected && dayExpected && expected !== dayExpected);
  const counter = expectations.some((value) => direction !== value);
  const aligned = Boolean(expectations.length && !counter);
  guard.dataset.state = counter ? "counter" : aligned ? "aligned" : "none";
  $("#countertrend-confirm").classList.toggle("hidden", !counter);
  $("#countertrend-evidence-field").classList.toggle("hidden", !counter);
  if (counter) {
    $("#trend-guard-title").textContent = planConflict ? "Дневной и недельный планы расходятся" : "Сделка против записанного направления";
    $("#trend-guard-copy").textContent = planConflict ? "Сначала устраните противоречие в планах или опишите подтверждённый новый сценарий." : "Направление не совпадает с планом дня или недели. Нужен подтверждённый разворот, а не ощущение.";
    $("#trend-guard-icon").textContent = expected === "BUY" ? "↑" : "↓";
  } else if (aligned) {
    $("#trend-guard-title").textContent = "Направление совпадает с планом";
    $("#trend-guard-copy").textContent = "Идеи дня и недели проверены. Теперь дождитесь записанного триггера.";
    $("#trend-guard-icon").textContent = expected === "BUY" ? "↑" : "↓";
    form.elements.countertrend_confirmed.checked = false;
  } else {
    $("#trend-guard-title").textContent = bias === "NEUTRAL" ? "Недельный план нейтральный" : "Выберите недельную идею";
    $("#trend-guard-copy").textContent = bias === "NEUTRAL" ? "Направление определяет подтверждённый сценарий сделки." : "Журнал сверит направление сделки с главным сценарием.";
    $("#trend-guard-icon").textContent = "→"; form.elements.countertrend_confirmed.checked = false;
  }
  updateEntryPermit();
}

function updateEntryPermit() {
  const form = $("#trade-form"); const permit = $("#entry-permit");
  if (!permit) return;
  const executing = ["open", "closed"].includes(form.elements.status.value);
  const visible = form.elements.journal_mode.value === "live" && executing;
  permit.classList.toggle("hidden", !visible);
  const breach = form.elements.entered_without_plan.checked;
  const ready = !breach && form.elements.trigger_confirmed.checked && form.elements.trigger_evidence.value.trim().length >= 12;
  permit.dataset.state = breach ? "breach" : ready ? "ready" : "waiting";
  $("#trigger-confirm").classList.toggle("hidden", breach);
  $("#trigger-evidence-field").classList.toggle("hidden", breach);
  if (breach) {
    $("#entry-permit-copy").textContent = "Это не разрешение на вход. Журнал честно отметит нарушение для будущей аналитики.";
    form.elements.plan_followed.value = "false";
    if (!form.elements.grade.value) form.elements.grade.value = "D";
    if (!form.elements.mistake.value) form.elements.mistake.value = "Вход без допуска журнала";
  } else if (!form.elements.trade_id.value) {
    $("#entry-permit-copy").textContent = "Сначала сохраните «Только план». После появления триггера вернитесь сюда и откройте сделку.";
  } else if (ready) {
    $("#entry-permit-copy").textContent = "План был сохранён заранее, направление проверено, триггер подтверждён.";
  } else {
    $("#entry-permit-copy").textContent = "План сохранён. Теперь дождитесь фактического триггера — раньше вход запрещён вашей системой.";
  }
}

function autoLinkWeeklyPlan(force = false) {
  const form = $("#trade-form");
  const symbol = form.elements.symbol.value.trim().toUpperCase();
  const tradeWeek = weekStartISO(form.elements.traded_at.value || todayISO());
  const match = state.currentWeeklyPlans.find((plan) => plan.symbol === symbol && plan.week_start === tradeWeek);
  if (match && (force || !form.elements.weekly_plan_id.value)) form.elements.weekly_plan_id.value = String(match.id);
  else if (force && !match) form.elements.weekly_plan_id.value = "";
  if (!form.dataset.directionTouched && !form.elements.direction.value) {
    const bias = match?.bias || form.dataset.dayBias;
    if (bias === "LONG") form.elements.direction.value = "BUY";
    if (bias === "SHORT") form.elements.direction.value = "SELL";
  }
  $("#weekly-link-hint").textContent = match ? `Найден план: ${match.title || match.idea.slice(0, 60)}` : "Для этого инструмента на выбранной неделе плана нет.";
  updateTrendGuard();
}

function renderTradeImagePreview(kind) {
  const container = $(`#trade-${kind}-preview`);
  if (container.dataset.objectUrl) { URL.revokeObjectURL(container.dataset.objectUrl); delete container.dataset.objectUrl; }
  const file = state.tradeImageFiles[kind];
  const saved = state.currentTradeImages.find((image) => image.kind === kind);
  if (!file && !saved) { container.innerHTML = ""; return; }
  const source = file ? URL.createObjectURL(file) : saved.url;
  if (file) container.dataset.objectUrl = source;
  const protectedSource = saved && !file ? ` data-protected-src="${escapeHtml(source)}"` : ` src="${escapeHtml(source)}"`;
  const readOnly = $("#trade-form").classList.contains("trade-form-readonly");
  const action = readOnly ? "" : `<button type="button" data-remove-trade-image="${kind}" aria-label="Удалить скриншот">×</button>`;
  container.innerHTML = `<figure><img${protectedSource} data-view-plan-image="${escapeHtml(source)}" alt="${kind === "entry" ? "График до входа" : "График после сделки"}">${action}<span class="saved-mark">${file ? "Будет сохранён" : kind === "entry" ? "До входа" : "Итог"}</span></figure>`;
  $("[data-remove-trade-image]", container)?.addEventListener("click", () => removeTradeImage(kind).catch(showRequestError));
  $("[data-view-plan-image]", container)?.addEventListener("click", () => openPlanImage(source).catch(showRequestError));
  if (saved && !file) hydrateProtectedImages(container);
}

async function removeTradeImage(kind) {
  if (state.tradeImageFiles[kind]) {
    state.tradeImageFiles[kind] = null; $(`#trade-${kind}-image`).value = ""; renderTradeImagePreview(kind); setDirty(true); return;
  }
  const image = state.currentTradeImages.find((item) => item.kind === kind);
  if (!image || !(await askConfirm("Удалить этот скриншот сделки?"))) return;
  await api(`/api/trade-images/${image.id}`, { method: "DELETE" });
  state.currentTradeImages = state.currentTradeImages.filter((item) => item.id !== image.id);
  renderTradeImagePreview(kind); setDirty(true); toast("Скриншот удалён");
}

async function uploadTradeImages(tradeId, button) {
  for (const kind of ["entry", "result"]) {
    const file = state.tradeImageFiles[kind];
    if (!file) continue;
    button.textContent = kind === "entry" ? "Загружаем скрин входа" : "Загружаем скрин итога";
    const prepared = await compressPlanImage(file); const body = new FormData();
    body.append("image", prepared.blob, prepared.name);
    const uploaded = await api(`/api/trades/${tradeId}/images/${kind}`, { method: "PUT", body });
    state.currentTradeImages = state.currentTradeImages.filter((item) => item.kind !== kind);
    state.currentTradeImages.push(uploaded.image); state.tradeImageFiles[kind] = null;
  }
}

function openTradeDialog(trade = null, readOnly = false) {
  const dialog = $("#trade-dialog"); const form = $("#trade-form");
  form.reset(); setTradeReadOnly(false);
  state.tradeImageFiles = { entry: null, result: null }; state.currentTradeImages = trade?.images || [];
  form.dataset.directionTouched = trade ? "true" : "";
  $("#trade-entry-image").value = ""; $("#trade-result-image").value = "";
  form.dataset.dayBias = state.bootstrap?.today_mood?.market_bias || "NEUTRAL";
  form.elements.traded_at.value = `${state.journalDay || todayISO()}T${localDateTimeValue().slice(11, 16)}`; form.elements.symbol.value = "XAUUSD";
  form.elements.timeframe.value = "M15"; form.elements.status.value = "planned";
  form.elements.journal_mode.value = state.bootstrap?.today_mood?.journal_mode || "backtest";
  form.elements.confidence_before.value = state.bootstrap?.today_mood?.confidence || 3;
  form.elements.plan_followed.value = "true"; form.elements.visibility.value = state.circle ? "team" : "private";
  form.elements.trade_id.value = ""; form.elements.client_entry_id.value = entryId();
  form.elements.outcome_type.value = ""; form.dataset.outcomeChoice = "";
  form.elements.trade_plan.value = state.bootstrap?.today_mood?.day_idea || "";
  form.elements.entry_trigger.value = state.bootstrap?.today_mood?.focus || "";
  form.elements.trade_invalidation.value = state.bootstrap?.today_mood?.day_invalidation || "";
  populateWeeklyPlanOptions();
  $("#delete-trade").classList.add("hidden");
  if (trade) {
    const fields = ["symbol", "direction", "status", "timeframe", "session", "setup", "grade", "market_context", "journal_mode", "confidence_before", "trade_plan", "entry_trigger", "trade_invalidation", "outcome_type", "weekly_plan_id", "countertrend_evidence", "trigger_evidence", "entry_price", "stop_loss", "take_profit", "volume", "risk_amount", "pnl", "r_multiple", "emotion_before", "emotion_after", "mistake", "note", "screenshot_url", "visibility"];
    populateWeeklyPlanOptions(trade.weekly_plan_id, trade);
    form.elements.trade_id.value = trade.id; form.elements.client_entry_id.value = trade.client_entry_id || "";
    form.dataset.dayBias = trade.day_plan_bias || "NEUTRAL";
    form.elements.traded_at.value = String(trade.traded_at).slice(0, 16);
    for (const field of fields) form.elements[field].value = trade[field] ?? "";
    form.elements.plan_followed.value = Number(trade.plan_followed) === 1 ? "true" : "false";
    form.elements.idea_followed.value = trade.idea_followed == null ? "" : Number(trade.idea_followed) === 1 ? "true" : "false";
    form.elements.countertrend_confirmed.checked = Number(trade.countertrend_confirmed) === 1;
    form.elements.trigger_confirmed.checked = Number(trade.trigger_confirmed) === 1;
    form.elements.entered_without_plan.checked = Number(trade.entered_without_plan) === 1;
    form.dataset.outcomeChoice = trade.outcome_type || (Number(trade.pnl) > 0 ? "take" : Number(trade.pnl) < 0 ? "stop" : trade.status === "closed" ? "breakeven" : "");
    form.elements.outcome_type.value = form.dataset.outcomeChoice;
    $("#delete-trade").classList.remove("hidden");
    if (!readOnly && trade.status === "planned") form.elements.status.value = "open";
    else if (!readOnly && trade.status === "open") form.elements.status.value = "closed";
  }
  if (!trade) autoLinkWeeklyPlan(); else updateTrendGuard();
  const statusRadio = $(`input[name="status_choice"][value="${form.elements.status.value}"]`, form);
  if (statusRadio) statusRadio.checked = true;
  $("#trade-confidence-output").value = form.elements.confidence_before.value || 3;
  setTradeReadOnly(readOnly); renderTradeImagePreview("entry"); renderTradeImagePreview("result"); updateTradeStage(); updateRPreview();
  showTradeStep(trade ? (trade.status === "closed" || trade.status === "cancelled" ? 3 : 2) : 1);
  setDirty(false); dialog.showModal(); dialog.focus({ preventScroll: true });
}

function tradePayload(form) {
  const data = new FormData(form); const payload = Object.fromEntries(data.entries());
  delete payload.trade_id; delete payload.status_choice;
  for (const key of ["entry_price", "stop_loss", "take_profit", "volume", "risk_amount", "pnl", "r_multiple", "confidence_before", "weekly_plan_id"]) payload[key] = payload[key] === "" ? null : Number(payload[key]);
  if (payload.status === "closed" && !payload.outcome_type && payload.pnl != null) payload.outcome_type = payload.pnl > 0 ? "take" : payload.pnl < 0 ? "stop" : "breakeven";
  payload.plan_followed = payload.plan_followed === "true";
  payload.idea_followed = payload.idea_followed === "" ? null : payload.idea_followed === "true";
  payload.countertrend_confirmed = $("#trend-guard").dataset.state === "counter" ? form.elements.countertrend_confirmed.checked : null;
  payload.trigger_confirmed = form.elements.trigger_confirmed.checked;
  payload.entered_without_plan = form.elements.entered_without_plan.checked;
  if (payload.entered_without_plan) {
    payload.plan_followed = false;
    if (payload.grade === "") payload.grade = "D";
    if (payload.mistake === "") payload.mistake = "Вход без допуска журнала";
  }
  if (payload.idea_followed == null && form.elements.weekly_plan_id.value) payload.idea_followed = $("#trend-guard").dataset.state !== "counter";
  return payload;
}

function updateRPreview() {
  const form = $("#trade-form"); const risk = Number(form.elements.risk_amount.value); const pnl = Number(form.elements.pnl.value);
  $("#r-preview").textContent = risk > 0 && form.elements.pnl.value !== "" ? `Итог: ${(pnl / risk).toFixed(2)}R` : "Укажите риск — результат в R посчитается сам.";
  if (risk > 0 && form.elements.pnl.value !== "" && !form.elements.r_multiple.matches(":focus")) form.elements.r_multiple.value = (pnl / risk).toFixed(2);
  form.elements.pnl.required = form.elements.status.value === "closed";
  const kind = form.dataset.outcomeChoice || (form.elements.pnl.value === "" ? "" : pnl > 0 ? "take" : pnl < 0 ? "stop" : "breakeven");
  $$(".outcome-choice button", form).forEach((button) => button.classList.toggle("active", button.dataset.outcome === kind));
  const badge = $("#outcome-badge");
  badge.textContent = ({ take: "Тейк", stop: "Стоп", breakeven: "Безубыток", manual: "Закрыта вручную", cancelled: "Отменена" })[kind] || "Не выбран";
  badge.dataset.outcome = kind || "none";
}

function updateTradeStage() {
  const form = $("#trade-form");
  const status = form.elements.status.value;
  const closed = status === "closed";
  $("#trade-outcome").classList.toggle("hidden", !closed);
  $("#result-pending").classList.toggle("hidden", closed);
  form.elements.pnl.required = closed;
  $("#save-trade").textContent = closed ? "Сохранить итог" : status === "open" ? "Сохранить открытую сделку" : status === "planned" ? "Сохранить план" : "Сохранить отмену";
  if (status === "cancelled") { form.elements.outcome_type.value = "cancelled"; form.dataset.outcomeChoice = "cancelled"; }
  else if (!closed) { form.elements.outcome_type.value = ""; form.dataset.outcomeChoice = ""; }
  else if (form.dataset.outcomeChoice === "cancelled") { form.elements.outcome_type.value = ""; form.dataset.outcomeChoice = ""; }
  updateRPreview();
  updateEntryPermit();
}

function chooseOutcome(kind) {
  const form = $("#trade-form");
  const field = form.elements.pnl;
  form.dataset.outcomeChoice = kind; form.elements.outcome_type.value = kind;
  if (kind === "breakeven") field.value = "0";
  else if (field.value !== "" && kind !== "manual") field.value = String(kind === "stop" ? -Math.abs(Number(field.value)) : Math.abs(Number(field.value)));
  field.placeholder = kind === "stop" ? "Например: -250" : kind === "take" ? "Например: 500" : kind === "manual" ? "Фактический итог" : "0";
  updateRPreview(); setDirty(true);
  if (kind !== "breakeven") field.focus();
}

function normalizeOutcomeInput() {
  const form = $("#trade-form");
  const field = form.elements.pnl;
  if (field.value !== "" && form.dataset.outcomeChoice === "stop" && Number(field.value) > 0) field.value = String(-Math.abs(Number(field.value)));
  if (field.value !== "" && form.dataset.outcomeChoice === "take" && Number(field.value) < 0) field.value = String(Math.abs(Number(field.value)));
  updateRPreview();
}

async function saveTrade(event) {
  event.preventDefault();
  const form = event.currentTarget; const button = $("#save-trade"); const id = form.elements.trade_id.value;
  if (!validateTradeStep(state.tradeStep)) return;
  await pending(button, async () => {
    const payload = tradePayload(form);
    const result = await api(id ? `/api/trades/${id}` : "/api/trades", { method: id ? "PUT" : "POST", body: JSON.stringify(payload) });
    await uploadTradeImages(result.trade.id, button);
    setDirty(false); $("#trade-dialog").close(); haptic("medium"); toast(id ? "Сделка обновлена" : "Сделка записана");
    state.journalDay = String(payload.traded_at).slice(0, 10);
    if (!weeksInMonth(state.journalMonth).includes(weekStartISO(state.journalDay))) state.journalMonth = monthISO(state.journalDay);
    await refreshJournalData();
    if (state.currentView === "calendar") { await loadCalendar(); if (state.selectedDay) await selectDay(state.selectedDay); }
  });
}

async function askConfirm(message) {
  return new Promise((resolve) => { if (tg?.showConfirm) tg.showConfirm(message, resolve); else resolve(window.confirm(message)); });
}

async function confirmDelete() {
  const id = $("#trade-form").elements.trade_id.value;
  if (!id || !(await askConfirm("Удалить эту сделку из журнала?"))) return;
  await pending($("#delete-trade"), async () => {
    await api(`/api/trades/${id}`, { method: "DELETE" }); setDirty(false); $("#trade-dialog").close(); toast("Сделка удалена"); await refreshJournalData();
    if (state.currentView === "calendar") await loadCalendar();
  });
}

function switchView(name) {
  if (name === state.currentView) return;
  state.currentView = name;
  $$(".view").forEach((view) => view.classList.toggle("active", view.id === `view-${name}`));
  $$(".bottom-nav button").forEach((button) => {
    const active = button.dataset.view === name; button.classList.toggle("active", active);
    if (active) button.setAttribute("aria-current", "page"); else button.removeAttribute("aria-current");
  });
  window.scrollTo({ top: 0, behavior: window.matchMedia("(prefers-reduced-motion: reduce)").matches ? "auto" : "smooth" });
  haptic();
  if (name === "calendar") loadCalendar().catch(showRequestError);
  if (name === "stats") loadStats().catch(showRequestError);
  if (name === "profile") { populateSettings(); renderTeam(); }
}

async function loadCalendar() {
  const requestId = ++state.calendarRequest;
  const month = `${state.calendarMonth.getFullYear()}-${String(state.calendarMonth.getMonth() + 1).padStart(2, "0")}`;
  const data = await api(`/api/calendar?month=${month}&scope=${state.calendarScope}`);
  if (requestId !== state.calendarRequest) return;
  state.calendarDays = new Map(data.days.map((item) => [item.day, item])); renderCalendar();
}

function renderCalendar() {
  const year = state.calendarMonth.getFullYear(); const month = state.calendarMonth.getMonth();
  $("#calendar-title").textContent = new Intl.DateTimeFormat("ru-RU", { month: "long", year: "numeric" }).format(state.calendarMonth);
  const firstWeekday = (new Date(year, month, 1).getDay() + 6) % 7; const daysCount = new Date(year, month + 1, 0).getDate(); const cells = [];
  for (let i = 0; i < firstWeekday; i += 1) cells.push('<div class="calendar-day" aria-hidden="true"></div>');
  for (let day = 1; day <= daysCount; day += 1) {
    const key = `${year}-${String(month + 1).padStart(2, "0")}-${String(day).padStart(2, "0")}`; const info = state.calendarDays.get(key); const pnl = Number(info?.pnl || 0);
    const classes = ["calendar-day", info ? "has-data" : "", key === todayISO() ? "today" : "", key === state.selectedDay ? "selected" : ""].filter(Boolean).join(" ");
    const aria = `${formatDate(key, { day: "numeric", month: "long" })}. ${tradesLabel(info?.trades)}. Результат ${formatMoney(pnl)}`;
    cells.push(`<button class="${classes}" data-day="${key}" type="button" aria-label="${escapeHtml(aria)}"><span>${day}</span><i class="discipline-dot ${Number(info?.discipline || 0) >= 4 ? "good" : ""}"></i>${info?.trades ? `<span class="day-pnl ${pnl > 0 ? "positive" : pnl < 0 ? "negative" : ""}">${pnl > 0 ? "+" : ""}${Math.round(pnl)}</span>` : "<span></span>"}</button>`);
  }
  $("#calendar-grid").innerHTML = cells.join("");
  $$(".calendar-day[data-day]").forEach((button) => button.addEventListener("click", () => selectDay(button.dataset.day).catch(showRequestError)));
}

async function selectDay(day) {
  const requestId = ++state.dayRequest; state.selectedDay = day; renderCalendar();
  const info = state.calendarDays.get(day) || { trades: 0, pnl: 0 };
  const payload = await api(`/api/trades?from=${day}&to=${day}&scope=${state.calendarScope}`);
  if (requestId !== state.dayRequest || state.selectedDay !== day) return;
  state.dayTrades = payload.trades || [];
  const container = $("#day-details");
  container.innerHTML = `<h2>${formatDate(day, { day: "numeric", month: "long", weekday: "long" })}</h2><div class="day-summary"><span>Сделок<strong>${info.trades || 0}</strong></span><span>Итог<strong class="${Number(info.pnl) > 0 ? "positive" : Number(info.pnl) < 0 ? "negative" : ""}">${formatMoney(info.pnl, true)}</strong></span><span>Дисциплина<strong>${info.discipline ? `${info.discipline}/5` : "—"}</strong></span></div><div class="trade-list"></div>`;
  renderTradeList($(".trade-list", container), state.dayTrades, true);
}

async function loadStats() {
  const requestId = ++state.statsRequest; const days = $("#stats-period").value;
  const data = await api(`/api/stats?days=${days}&end=${todayISO()}&scope=${state.statsScope}`);
  if (requestId !== state.statsRequest) return;
  const stats = data.stats;
  $("#stats-pnl").textContent = formatMoney(stats.pnl, true); $("#stats-pnl").className = `money ${Number(stats.pnl) > 0 ? "positive" : Number(stats.pnl) < 0 ? "negative" : ""}`;
  $("#stats-trades").textContent = tradesLabel(stats.trades); $("#stats-winrate").textContent = `${stats.win_rate || 0}%`; $("#stats-wl").textContent = `${stats.wins || 0} / ${stats.losses || 0}`;
  $("#stats-pf").textContent = stats.profit_factor == null ? "—" : Number(stats.profit_factor).toFixed(2); $("#stats-r").textContent = stats.avg_r == null ? "—" : `${Number(stats.avg_r).toFixed(2)}R`;
  $("#stats-expectancy").textContent = formatMoney(stats.expectancy, true); $("#stats-drawdown").textContent = formatMoney(-Math.abs(Number(stats.max_drawdown || 0)));
  $("#stats-plan").textContent = `${stats.plan_rate || 0}% по плану`;
  renderEquity(stats.equity_curve || []); renderObservation(stats); renderBreakdown($("#setup-breakdown"), stats.setups, "pnl"); renderBreakdown($("#session-breakdown"), stats.sessions, "pnl"); renderBreakdown($("#mistake-breakdown"), stats.mistakes, "trades"); renderPatterns($("#confidence-patterns"), stats.confidence_patterns, "Уверенность"); renderPatterns($("#mood-patterns"), stats.mood_patterns, "Настроение");
}

function renderEquity(points) {
  const box = $("#equity-chart");
  if (points.length < 2) { box.innerHTML = '<div class="chart-empty">Нужно минимум два торговых дня.</div>'; return; }
  const values = points.map((item) => Number(item.equity)); const min = Math.min(0, ...values); const max = Math.max(0, ...values); const range = max - min || 1;
  const coords = values.map((value, index) => [index / (values.length - 1) * 100, 92 - (value - min) / range * 78]);
  const line = coords.map(([x, y], index) => `${index ? "L" : "M"}${x.toFixed(2)},${y.toFixed(2)}`).join(" ");
  const area = `${line} L100,100 L0,100 Z`;
  box.innerHTML = `<svg viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true"><path class="area" d="${area}"/><path class="line" d="${line}"/></svg>`;
}

function renderObservation(stats) {
  let title = "Недостаточно записей"; let copy = "После трёх сделок здесь появится конкретное наблюдение.";
  if (Number(stats.trades) >= 3) {
    const confidenceGroups = (stats.confidence_patterns || []).filter((item) => Number(item.trades) >= 3);
    const confidenceSamples = confidenceGroups.reduce((sum, item) => sum + Number(item.trades), 0);
    const bestConfidence = [...confidenceGroups].sort((a, b) => Number(b.win_rate) - Number(a.win_rate))[0];
    const worstConfidence = [...confidenceGroups].sort((a, b) => Number(a.win_rate) - Number(b.win_rate))[0];
    const topMistake = stats.mistakes?.[0]; const topSetup = stats.setups?.filter((item) => Number(item.pnl) > 0).sort((a, b) => Number(b.pnl) - Number(a.pnl))[0];
    if (confidenceSamples >= 10 && confidenceGroups.length >= 2 && Number(bestConfidence.win_rate) - Number(worstConfidence.win_rate) >= 15) { title = `Уверенность ${bestConfidence.label}/5 даёт лучший результат`; copy = `Винрейт ${bestConfidence.win_rate}% против ${worstConfidence.win_rate}% при уверенности ${worstConfidence.label}/5. Это связь в ваших записях, а не доказанная причина.`; }
    else if (Number(stats.plan_rate) < 70) { title = `${stats.plan_rate}% сделок выполнено по плану`; copy = "Это самый прямой участок для улучшения процесса на следующей неделе."; }
    else if (topMistake && Number(topMistake.trades) >= 2) { title = `Повторяется: ${topMistake.label}`; copy = `Ошибка отмечена в ${tradesLabel(topMistake.trades)} за выбранный период.`; }
    else if (topSetup) { title = `Лучший сетап: ${topSetup.label}`; copy = `${tradesLabel(topSetup.trades)}, результат ${formatMoney(topSetup.pnl, true)}, винрейт ${topSetup.win_rate}%.`; }
    else { title = `${stats.plan_rate}% сделок по плану`; copy = `Средняя дисциплина ${stats.avg_discipline || 0}/5, записано дней: ${stats.journal_days || 0}.`; }
  }
  $("#stats-observation").textContent = title; $("#stats-observation-copy").textContent = copy;
}

function renderPatterns(container, rows = [], label = "Оценка") {
  if (!rows?.length) { container.innerHTML = '<div class="breakdown-empty">Появится после сделок с заполненным состоянием.</div>'; return; }
  container.innerHTML = rows.map((row) => {
    const enough = Number(row.trades) >= 3;
    const outcome = Number(row.takes || 0) || Number(row.stops || 0) ? `${row.takes || 0} тейков · ${row.stops || 0} стопов` : `${row.win_rate}% прибыльных`;
    return `<div class="pattern-row"><span class="pattern-score">${escapeHtml(row.label)}</span><div><strong>${label} ${escapeHtml(row.label)}/5</strong><small>${tradesLabel(row.trades)} · ${outcome}</small></div><span class="pattern-result ${Number(row.pnl) > 0 ? "positive" : Number(row.pnl) < 0 ? "negative" : ""}">${enough ? `${row.win_rate}%` : "мало данных"}<small>${row.avg_r == null ? "—" : `${Number(row.avg_r).toFixed(2)}R`}</small></span></div>`;
  }).join("");
}

function renderBreakdown(container, rows = [], mode = "pnl") {
  if (!rows?.length) { container.innerHTML = '<div class="breakdown-empty">Пока нет данных.</div>'; return; }
  container.innerHTML = rows.map((row) => `<div class="breakdown-row"><div><span>${escapeHtml(row.label)}</span><small>${tradesLabel(row.trades)} · ${row.win_rate}% побед</small></div><strong class="${Number(row.pnl) > 0 ? "positive" : Number(row.pnl) < 0 ? "negative" : ""}">${mode === "trades" ? row.trades : formatMoney(row.pnl, true)}</strong></div>`).join("");
}

async function saveSettings(event) {
  event.preventDefault(); const form = event.currentTarget; const button = $("button[type='submit']", form);
  await pending(button, async () => {
    const payload = Object.fromEntries(new FormData(form).entries());
    for (const key of ["balance", "profit_target_pct", "daily_loss_limit_pct", "max_loss_limit_pct", "risk_per_trade_pct", "max_trades_day"]) payload[key] = Number(payload[key]);
    const data = await api("/api/settings", { method: "PUT", body: JSON.stringify(payload) }); state.settings = data.settings; state.bootstrap.settings = data.settings; setDirty(false); renderHeader(); renderToday(); toast("Настройки счёта сохранены"); haptic();
  });
}

function renderTeam() {
  const active = Boolean(state.circle); $("#team-empty").classList.toggle("hidden", active); $("#team-active").classList.toggle("hidden", !active); if (!active) return;
  $("#invite-code").textContent = state.circle.invite_code;
  $("#team-members").innerHTML = (state.circle.members || []).map((member) => { const name = displayName(member); return `<article class="member"><div class="member-avatar">${escapeHtml(name.slice(0, 1).toUpperCase())}</div><div><strong>${escapeHtml(name)}</strong><small>${Number(member.id) === Number(state.user.id) ? "Это вы" : "Напарник"}</small></div></article>`; }).join("");
}

async function createTeam(event) {
  event.preventDefault(); const form = event.currentTarget;
  await pending($("button[type='submit']", form), async () => { const name = new FormData(form).get("name"); const data = await api("/api/circles", { method: "POST", body: JSON.stringify({ name }) }); state.circle = data.circle; renderTeam(); haptic("medium"); toast("Команда создана"); });
}

async function joinTeam(event) {
  event.preventDefault(); const form = event.currentTarget;
  await pending($("button[type='submit']", form), async () => { const invite_code = new FormData(form).get("invite_code"); const data = await api("/api/circles/join", { method: "POST", body: JSON.stringify({ invite_code }) }); state.circle = data.circle; renderTeam(); haptic("medium"); toast("Вы в команде"); });
}

async function leaveTeam() {
  if (!(await askConfirm("Распустить команду? Общий доступ к прежним записям закроется у обоих."))) return;
  await pending($("#leave-team"), async () => { await api("/api/circles/leave", { method: "POST", body: "{}" }); state.circle = null; renderTeam(); toast("Команда распущена"); });
}

async function copyInvite() {
  const code = state.circle?.invite_code; if (!code) return;
  try { await navigator.clipboard.writeText(code); }
  catch (_) { const input = document.createElement("textarea"); input.value = code; input.style.position = "fixed"; input.style.opacity = "0"; document.body.appendChild(input); input.select(); document.execCommand("copy"); input.remove(); }
  haptic(); toast("Код скопирован");
}

async function exportCsv() {
  await pending($("#export-button"), async () => {
    const response = await fetch("/api/export", { headers: { "X-Telegram-Init-Data": tg?.initData || "" } });
    if (!response.ok) throw new Error("Не удалось подготовить экспорт");
    const blob = await response.blob(); const url = URL.createObjectURL(blob); const anchor = document.createElement("a"); anchor.href = url; anchor.download = `trading-journal-${todayISO()}.csv`; document.body.appendChild(anchor); anchor.click(); anchor.remove(); URL.revokeObjectURL(url); toast("CSV подготовлен");
  });
}

async function copyAnalysisPrompt() {
  const prompt = `Проанализируй приложенный CSV моего торгового журнала как датасет бэктестов. Найди не советы по отдельным сделкам, а повторяющиеся закономерности. Сравни confidence_before, day_mood, day_energy, day_confidence и day_emotion с outcome_type, pnl, r_multiple, plan_followed, entered_without_plan, trigger_confirmed, mistake, setup и session. Отдельно покажи: 1) условия, при которых у меня чаще стопы; 2) условия, при которых чаще тейки; 3) цену ранних входов и входов без допуска; 4) результаты сделок по идее и против недельной идеи; 5) повторяющиеся ошибки; 6) какие гипотезы проверить следующим бэктестом. Не делай уверенных выводов для группы меньше 5 сделок, указывай размер выборки и отличай корреляцию от причины. В конце дай короткий план из трёх проверяемых изменений.`;
  try { await navigator.clipboard.writeText(prompt); }
  catch (_) { const input = document.createElement("textarea"); input.value = prompt; input.style.position = "fixed"; input.style.opacity = "0"; document.body.appendChild(input); input.select(); document.execCommand("copy"); input.remove(); }
  haptic(); toast("Запрос для анализа скопирован");
}

async function websiteLogout() {
  const response = await fetch("/auth/logout", { method: "POST" });
  if (!response.ok) throw new Error("Не удалось выйти из сайта");
  window.location.replace("/login");
}

function setScope(group, value) {
  $$(`[data-scope-control="${group}"] button`).forEach((button) => { const active = button.dataset.scope === value; button.classList.toggle("active", active); button.setAttribute("aria-pressed", String(active)); });
}

function showRequestError(error) { console.error(error); notifyError(); toast(error.message || "Не удалось выполнить действие", 4200); }

function bindEvents() {
  $("#web-logout").classList.toggle("hidden", Boolean(tg?.initData));
  $$(".bottom-nav button").forEach((button) => button.addEventListener("click", () => switchView(button.dataset.view)));
  $("#profile-shortcut").addEventListener("click", () => switchView("profile"));
  $("#new-trade-primary").addEventListener("click", runPrimaryAction);
  for (const selector of ["#open-trade-button", "#floating-trade-button"]) $(selector).addEventListener("click", () => openTradeDialog());
  $("#edit-plan").addEventListener("click", editPlan);
  $("#mood-form").addEventListener("submit", (event) => saveMood(event).catch(showRequestError));
  $("#settings-form").addEventListener("submit", (event) => saveSettings(event).catch(showRequestError));
  $("#weekly-plan-form").addEventListener("submit", (event) => saveWeeklyPlan(event).catch(showRequestError));
  for (const form of [$("#mood-form"), $("#settings-form"), $("#trade-form"), $("#weekly-plan-form")]) form.addEventListener("input", () => setDirty(true));
  $("#add-weekly-plan").addEventListener("click", () => openWeeklyPlanDialog());
  $("#journal-month-prev").addEventListener("click", () => shiftJournalMonth(-1).catch(showRequestError));
  $("#journal-month-next").addEventListener("click", () => shiftJournalMonth(1).catch(showRequestError));
  $("#journal-month").addEventListener("change", (event) => selectJournalMonth(event.target.value).catch(showRequestError));
  $("#weekly-plan-images").addEventListener("change", () => { renderWeeklyImagePreview(); setDirty(true); });
  $("#delete-weekly-plan").addEventListener("click", () => deleteWeeklyPlan().catch(showRequestError));
  $("#close-weekly-plan").addEventListener("click", async () => { if (!state.dirty || await askConfirm("Закрыть недельный план без сохранения?")) { setDirty(false); $("#weekly-plan-dialog").close(); } });
  $("#weekly-plan-dialog").addEventListener("cancel", (event) => { if (state.dirty) { event.preventDefault(); askConfirm("Закрыть недельный план без сохранения?").then((ok) => { if (ok) { setDirty(false); $("#weekly-plan-dialog").close(); } }); } });
  $("#close-plan-image").addEventListener("click", closePlanImage);
  $("#plan-image-viewer").addEventListener("cancel", (event) => { event.preventDefault(); closePlanImage(); });
  for (const key of ["energy", "confidence", "discipline"]) $(`#${key}`).addEventListener("input", (event) => { $(`#${key}-output`).value = event.target.value; });
  $("#close-trade-dialog").addEventListener("click", async () => { if (!state.dirty || await askConfirm("Закрыть без сохранения?") ) { setDirty(false); $("#trade-dialog").close(); } });
  $("#trade-dialog").addEventListener("cancel", (event) => { if (state.dirty) { event.preventDefault(); askConfirm("Закрыть без сохранения?").then((ok) => { if (ok) { setDirty(false); $("#trade-dialog").close(); } }); } });
  $("#trade-form").addEventListener("submit", (event) => saveTrade(event).catch(showRequestError)); $("#delete-trade").addEventListener("click", () => confirmDelete().catch(showRequestError));
  $("#trade-form").elements.risk_amount.addEventListener("input", updateRPreview);
  $("#trade-form").elements.pnl.addEventListener("input", normalizeOutcomeInput);
  for (const kind of ["entry", "result"]) $(`#trade-${kind}-image`).addEventListener("change", (event) => {
    state.tradeImageFiles[kind] = event.target.files[0] || null; renderTradeImagePreview(kind); setDirty(true);
  });
  $("#trade-confidence").addEventListener("input", (event) => { $("#trade-confidence-output").value = event.target.value; });
  $("#trade-form").elements.symbol.addEventListener("input", () => autoLinkWeeklyPlan(true));
  $("#trade-form").elements.traded_at.addEventListener("change", () => autoLinkWeeklyPlan(true));
  $("#trade-form").elements.direction.addEventListener("change", () => { $("#trade-form").dataset.directionTouched = "true"; updateTrendGuard(); });
  $("#trade-form").elements.weekly_plan_id.addEventListener("change", updateTrendGuard);
  $("#trade-form").elements.journal_mode.addEventListener("change", updateEntryPermit);
  $("#trade-form").elements.trigger_confirmed.addEventListener("change", updateEntryPermit);
  $("#trade-form").elements.trigger_evidence.addEventListener("input", updateEntryPermit);
  $("#trade-form").elements.entered_without_plan.addEventListener("change", updateEntryPermit);
  $("#trade-form").elements.countertrend_confirmed.addEventListener("change", (event) => {
    if (event.target.checked && $("#trade-form").elements.idea_followed.value === "") $("#trade-form").elements.idea_followed.value = "true";
  });
  $$("input[name='status_choice']").forEach((radio) => radio.addEventListener("change", () => { $("#trade-form").elements.status.value = radio.value; updateTradeStage(); setDirty(true); }));
  $$(".outcome-choice button").forEach((button) => button.addEventListener("click", () => chooseOutcome(button.dataset.outcome)));
  $$("[data-trade-step]").forEach((button) => button.addEventListener("click", () => { const target = Number(button.dataset.tradeStep); if (target <= state.tradeStep || validateTradeStep(state.tradeStep)) showTradeStep(target); }));
  $("#trade-next").addEventListener("click", () => {
    if (!validateTradeStep(state.tradeStep)) return;
    const form = $("#trade-form");
    if (state.tradeStep === 2 && form.elements.journal_mode.value !== "live" && ["planned", "open"].includes(form.elements.status.value)) {
      form.elements.status.value = "closed";
      const radio = $("input[name='status_choice'][value='closed']", form); if (radio) radio.checked = true;
      updateTradeStage();
    }
    showTradeStep(state.tradeStep + 1); haptic();
  });
  $("#trade-back").addEventListener("click", () => showTradeStep(state.tradeStep - 1));
  $("#calendar-prev").addEventListener("click", () => { state.calendarMonth.setMonth(state.calendarMonth.getMonth() - 1); state.selectedDay = null; loadCalendar().catch(showRequestError); });
  $("#calendar-next").addEventListener("click", () => { state.calendarMonth.setMonth(state.calendarMonth.getMonth() + 1); state.selectedDay = null; loadCalendar().catch(showRequestError); });
  $$('[data-scope-control="calendar"] button').forEach((button) => button.addEventListener("click", () => { state.calendarScope = button.dataset.scope; setScope("calendar", state.calendarScope); state.selectedDay = null; loadCalendar().catch(showRequestError); }));
  $$('[data-scope-control="stats"] button').forEach((button) => button.addEventListener("click", () => { state.statsScope = button.dataset.scope; setScope("stats", state.statsScope); loadStats().catch(showRequestError); }));
  $("#stats-period").addEventListener("change", () => loadStats().catch(showRequestError));
  $("#create-team-form").addEventListener("submit", (event) => createTeam(event).catch(showRequestError)); $("#join-team-form").addEventListener("submit", (event) => joinTeam(event).catch(showRequestError));
  $("#copy-invite").addEventListener("click", () => copyInvite().catch(showRequestError)); $("#leave-team").addEventListener("click", () => leaveTeam().catch(showRequestError));
  $("#export-button").addEventListener("click", () => exportCsv().catch(showRequestError)); $("#retry-button").addEventListener("click", () => window.location.reload());
  $("#copy-ai-prompt").addEventListener("click", () => copyAnalysisPrompt().catch(showRequestError));
  $("#web-logout").addEventListener("click", () => websiteLogout().catch(showRequestError));
  tg?.onEvent?.("themeChanged", applyTelegramTheme);
}

async function start() {
  applyTelegramTheme(); state.journalDay = todayISO(); state.journalMonth = monthISO(); bindEvents();
  await loadBootstrap(); await loadJournalPeriod(state.journalMonth); setLoading(false);
}
start().catch(showFatal);
