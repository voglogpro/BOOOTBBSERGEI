# Token from @BotFather. Required in production.
BOT_TOKEN=

# Optional comma-separated Telegram user IDs. When empty, any user who opens
# the Mini App through this bot can create a private journal.
ALLOWED_USER_IDS=

# BotHost persistent storage path. For local work use ./data/trader_journal.sqlite3
DATABASE_PATH=/app/data/trader_journal.sqlite3
PORT=8080
MAX_AUTH_AGE_SECONDS=86400

# Local browser preview only. Never enable this in production.
DEV_MODE=false
DEV_USER_ID=100001
DEV_USER_NAME=Тестовый трейдер
