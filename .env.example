# Local defaults. On BotHost use /app/data for DATA_DIR and DATABASE_PATH.
APP_ENV=development
DATA_DIR=./data
DATABASE_PATH=./data/leads.sqlite3
TIMEZONE=Europe/Moscow

# Master switch. Keep false until the Telethon stage is configured and tested.
COLLECTOR_ENABLED=false

# Core <-> reader authentication (generate a separate random value in production).
READER_SHARED_SECRET=

# Telegram API application for the separate user account.
# Never put a phone number, login code or 2FA password in environment variables.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_EXPECTED_USER_ID=

# Local administrative CLI session. This file is not used by the BotHost Mini App.
TELEGRAM_SESSION_PATH=./data/telegram/reader.session
READER_STATE_PATH=./data/reader-state.sqlite3
CORE_INTERNAL_URL=http://127.0.0.1:3000

# Mini App / CRM bot. BOT_TOKEN must belong to the bot that opens this Mini App.
BOT_TOKEN=
ADMIN_TELEGRAM_IDS=
SESSION_ENCRYPTION_KEY=
ENCRYPTED_SESSION_PATH=./data/telegram/reader.session.enc
MINIAPP_INIT_DATA_MAX_AGE_SECONDS=300
LOGIN_CHALLENGE_TTL_SECONDS=300
PUBLIC_BASE_URL=
APP_HOST=0.0.0.0
APP_PORT=3000
# BotHost supplies PORT. It takes precedence over APP_PORT.
PORT=3000

# Pilot safety limits.
# Pilot is live-only. Keep 0 until a separate bounded catch-up design is tested.
READER_CATCHUP_LIMIT=0
READER_QUEUE_MAX=10000
REJECTED_MESSAGE_RETENTION_DAYS=7
